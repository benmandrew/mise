import Mise.Frontend.Dsl

/-!
# gen-header

A header generated by a script, and C files whose includes are found by the
compiler's depfile instead of being listed by hand. The generated header is
the only generated file a compile may read, so it is each compile's
`mayReadGenerated`.
-/

namespace GenHeader
open Mise.Frontend

def build (ps : Params) : Build Unit := do
  let mainC ← source "main.c"
  let utilC ← source "util.c"
  let _ ← sources ["util.h", "extra.h"]
  let genPy ← source "gen-config.py"
  let configIn ← source "config.in"
  let gen ← rule "gen" "python3 $in $out" (description := "GEN $out")
  let cc ← rule "cc" "cc $cflags -MMD -MF $out.d -Ibuild -I. -c $in -o $out"
    (description := "CC $out") (depfile := true)
  let link ← rule "link" "cc $in -o $out" (description := "LINK $out")
  let cflags := [("cflags", ps.get "cflags" "-O2 -Wall")]
  let config ← edge1 gen "build/config.h" [genPy, configIn]
  let mainO ← dynEdge1 cc "build/main.o" [mainC] (mayReadGenerated := [config]) (vars := cflags)
  let utilO ← dynEdge1 cc "build/util.o" [utilC] (mayReadGenerated := [config]) (vars := cflags)
  let app ← edge1 link "build/app" [mainO, utilO]
  defaults [app]

end GenHeader
