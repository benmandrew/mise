import Mise.Syntax.Ast

/-!
# Stage 3: printer

The printer works on character lists. Each statement prints as a list of
lines without their newlines; `printChars` joins them.
-/

namespace Mise.Syntax

/-- One path character as written in a manifest: `$`, space and `:` become
`$$`, `$ ` and `$:`; any other character is written as itself. -/
def escPathChar (c : Char) : List Char :=
  if c = '$' then ['$', '$'] else if c = ' ' then ['$', ' '] else if c = ':' then ['$', ':'] else [c]

/-- A path with each character escaped by `escPathChar`. -/
def escPath (p : Path) : List Char := p.toList.flatMap escPathChar

/-- One character of literal value text: `$` becomes `$$`; any other
character is written as itself. -/
def escValChar (c : Char) : List Char := if c = '$' then ['$', '$'] else [c]

/-- Escape literal text at the start of a value. Ninja skips spaces after `=`,
so a leading space must be written `$ `. -/
def escLead : List Char → List Char
  | [] => []
  | c :: cs => if c = ' ' then '$' :: ' ' :: cs.flatMap escValChar else (c :: cs).flatMap escValChar

/-- A value segment as text: literal text with `$` escaped, or a variable
reference written `${name}`. -/
def renderSeg : Seg → List Char
  | .lit s => s.toList.flatMap escValChar
  | .var n => '$' :: '{' :: (n.toList ++ ['}'])

/-- A value as text. A leading literal segment goes through `escLead`, so a
leading space is kept; the other segments go through `renderSeg`. -/
def renderVal : EvalString → List Char
  | [] => []
  | .lit s :: rest => escLead s.toList ++ rest.flatMap renderSeg
  | .var n :: rest => renderSeg (.var n) ++ rest.flatMap renderSeg

/-- Each path preceded by a space. -/
def pathList (ps : List Path) : List Char := ps.flatMap (fun p => ' ' :: escPath p)

/-- An optional `|` or `||` section. -/
def pathSection (sep : List Char) (ps : List Path) : List Char :=
  if ps.isEmpty then [] else ' ' :: sep ++ pathList ps

/-- The line `key = value`, indented by two spaces when `indent` is true. -/
def bindingLine (indent : Bool) (b : Binding) : List Char :=
  (if indent then [' ', ' '] else []) ++ b.1.toList ++ [' ', '=', ' '] ++ renderVal b.2

/-- The `build` line of an edge: outputs, `|` and implicit outputs, `:`, the
rule, inputs, `|` and implicit inputs, `||` and order-only inputs. An empty
`|` or `||` section is left out. The edge's bindings are not on this line. -/
def edgeLine (e : Edge) : List Char :=
  ['b', 'u', 'i', 'l', 'd'] ++ pathList e.outs ++ pathSection ['|'] e.implicitOuts ++
    [':', ' '] ++ e.rule.toList ++ pathList e.ins ++ pathSection ['|'] e.implicitIns ++
    pathSection ['|', '|'] e.orderOnly

/-- The lines of one statement. A rule is followed by its indented bindings
and a blank line, and an edge by its indented bindings. -/
def printStmt : Stmt → List (List Char)
  | .binding k v => [bindingLine false (k, v)]
  | .rule r => (['r', 'u', 'l', 'e', ' '] ++ r.name.toList) :: r.bindings.map (bindingLine true) ++ [[]]
  | .edge e => edgeLine e :: e.bindings.map (bindingLine true)
  | .default ps => (['d', 'e', 'f', 'a', 'u', 'l', 't'] ++ pathList ps) :: []

/-- The comment line at the top of every manifest `mise` writes. -/
def headerLine : List Char := "# Generated by mise. Do not edit.".toList

/-- The lines of a manifest: the header comment, then the lines of each
statement in order. -/
def printLines (m : Manifest) : List (List Char) := headerLine :: m.stmts.flatMap printStmt

/-- The lines of a manifest, each followed by a newline. -/
def printChars (m : Manifest) : List Char := (printLines m).flatMap (· ++ ['\n'])

/-- The text of a manifest, as `mise` writes it.
Gloss: the text of {m} -/
def print (m : Manifest) : String := String.ofList (printChars m)

end Mise.Syntax
