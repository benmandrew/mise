import Mise.Frontend.Dsl

/-!
# Test graphs

Builds for the model tests, written with the DSL. They have the same shape as
the examples' `mise.toml` files, but nothing keeps them in step: they test the
model, and the shell tests run the examples themselves through `mise` and
real Ninja.
-/

namespace MiseTest.Fixtures
open Mise.Frontend

/-- Two C files and a header, with the header listed by hand as an implicit
input of each compile. -/
def helloC (ps : Params) : Build Unit := do
  let mainC ← source "main.c"
  let greetC ← source "greet.c"
  let greetH ← source "greet.h"
  let cc ← rule "cc" "cc $cflags -c $in -o $out" (description := "CC $out")
  let link ← rule "link" "cc $in -o $out" (description := "LINK $out")
  let cflags := [("cflags", ps.get "cflags" "-O2 -Wall")]
  let mainO ← edge1 cc "build/main.o" [mainC] (implicitIns := [greetH]) (vars := cflags)
  let greetO ← edge1 cc "build/greet.o" [greetC] (implicitIns := [greetH]) (vars := cflags)
  let hello ← edge1 link "build/hello" [mainO, greetO]
  defaults [hello]

/-- A header generated by a script, and C files whose includes are found by
the compiler's depfile. The generated header is the only generated file a
compile may read. The generator's rule has `restat`, so a change to
`config.in` that leaves the header the same rebuilds nothing else. -/
def genHeader (ps : Params) : Build Unit := do
  let mainC ← source "main.c"
  let utilC ← source "util.c"
  let _ ← sources ["util.h", "extra.h"]
  let genPy ← source "gen-config.py"
  let configIn ← source "config.in"
  let gen ← rule "gen" "python3 $in $out" (description := "GEN $out") (restat := true)
  let cc ← rule "cc" "cc $cflags -MMD -MF $out.d -Ibuild -I. -c $in -o $out"
    (description := "CC $out") (depfile := true)
  let link ← rule "link" "cc $in -o $out" (description := "LINK $out")
  let cflags := [("cflags", ps.get "cflags" "-O2 -Wall")]
  let config ← edge1 gen "build/config.h" [genPy, configIn]
  let mainO ← dynEdge1 cc "build/main.o" [mainC] (mayReadGenerated := [config]) (vars := cflags)
  let utilO ← dynEdge1 cc "build/util.o" [utilC] (mayReadGenerated := [config]) (vars := cflags)
  let app ← edge1 link "build/app" [mainO, utilO]
  defaults [app]

end MiseTest.Fixtures
