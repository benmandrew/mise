#def-head("Syntax.Edge", "def:Mise.Syntax.Edge", "Mise/Syntax/Ast.lean", 36, 47, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L36-L47", ())[
