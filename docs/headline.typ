#def-head("Syntax.Edge.allOuts", "def:Mise.Syntax.Edge.allOuts", "Mise/Syntax/Ast.lean", 67, 68, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L67-L68", ())[
