#def-head("Syntax.Manifest", "def:Mise.Syntax.Manifest", "Mise/Syntax/Ast.lean", 58, 63, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L58-L63", ())[
