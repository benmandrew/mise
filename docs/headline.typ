#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Syntax.validEval", "def:Mise.Syntax.validEval", "Mise/Syntax/Ast.lean", 121, 123)

#"Every segment is valid and no two literal segments are adjacent (";#raw("noAdjLits");#").";

#raw(lang: "lean", block: true, "def validEval (e : EvalString) : Bool := e.all Seg.valid && noAdjLits e")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.Seg.valid"))[#raw("Syntax.Seg.valid");];, #link(label("def:Mise.Syntax.noAdjLits"))[#raw("Syntax.noAdjLits");];]

#def-heading("Syntax.splitSlash", "def:Mise.Syntax.splitSlash", "Mise/Syntax/Ast.lean", 125, 132)

#"Split a character list at every ";#raw("/");#".";

#raw(lang: "lean", block: true, "def splitSlash : List Char → List (List Char)\n  | [] => [[]]\n  | c :: r =>\n    if c = '/' then [] :: splitSlash r\n    else match splitSlash r with\n      | l :: ls => (c :: l) :: ls\n      | [] => [[c]]")

#def-heading("Syntax.canonical", "def:Mise.Syntax.canonical", "Mise/Syntax/Ast.lean", 134, 141)

#"A path Ninja's ";#raw("CanonicalizePath");#" leaves unchanged, conservatively: no empty, ";#raw(".");#" or ";#raw("..");#" component, except a leading ";#raw("/");#".";

#raw(lang: "lean", block: true, "def canonical (p : List Char) : Bool :=\n  match splitSlash p with\n  | [] => false\n  | first :: rest =>\n    let bad (c : List Char) := c == ['.'] || c == ['.', '.']\n    (rest.all fun c => !c.isEmpty && !bad c) && !bad first && (!first.isEmpty || !rest.isEmpty)")
#uses[#link(label("def:Mise.Syntax.splitSlash"))[#raw("Syntax.splitSlash");];]

#def-heading("Syntax.validPath", "def:Mise.Syntax.validPath", "Mise/Syntax/Ast.lean", 143, 146)

#"A path ";#raw("mise");#" accepts: nonempty, made of path characters (";#raw("pathChar");#"), and canonical (";#raw("canonical");#").";

#raw(lang: "lean", block: true, "def validPath (p : Path) : Bool :=\n  !p.toList.isEmpty && p.toList.all pathChar && canonical p.toList")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.canonical"))[#raw("Syntax.canonical");];, #link(label("def:Mise.Syntax.pathChar"))[#raw("Syntax.pathChar");];]

#def-heading("Syntax.validBinding", "def:Mise.Syntax.validBinding", "Mise/Syntax/Ast.lean", 148, 149)

#"The key is an identifier and the value is valid.";

#raw(lang: "lean", block: true, "def validBinding (b : Binding) : Bool := validIdent b.1 && validEval b.2")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.validEval"))[#raw("Syntax.validEval");];, #link(label("def:Mise.Syntax.validIdent"))[#raw("Syntax.validIdent");];]

#def-heading("Syntax.nodupB", "def:Mise.Syntax.nodupB", "Mise/Syntax/Ast.lean", 151, 154)

#"No string occurs twice in the list.";

#raw(lang: "lean", block: true, "def nodupB : List String → Bool\n  | [] => true\n  | x :: xs => !xs.contains x && nodupB xs")

#def-heading("Syntax.Ctx", "def:Mise.Syntax.Ctx", "Mise/Syntax/Ast.lean", 158, 163)

#"What the parser model knows after reading a prefix of the manifest.";

#raw(lang: "lean", block: true, "structure Ctx where\n  rules : List String := [\"phony\"]\n  outs : List Path := []\n  known : List Path := []\n  deriving Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Syntax.Ctx.add", "def:Mise.Syntax.Ctx.add", "Mise/Syntax/Ast.lean", 165, 171)

#"Record a statement in the context. A rule adds its name to the rules; an edge adds its outputs to ";#raw("outs");#" and all its paths to ";#raw("known");#". Other statements change nothing.";

#raw(lang: "lean", block: true, "def Ctx.add (c : Ctx) : Stmt → Ctx\n  | .rule r => { c with rules := c.rules ++ [r.name] }\n  | .edge e => { c with outs := c.outs ++ e.allOuts, known := c.known ++ e.allPaths }\n  | _ => c")
#uses[#link(label("def:Mise.Syntax.Ctx"))[#raw("Syntax.Ctx");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Edge.allOuts"))[#raw("Syntax.Edge.allOuts");];, #link(label("def:Mise.Syntax.Edge.allPaths"))[#raw("Syntax.Edge.allPaths");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];]

#def-heading("Syntax.Stmt.ok", "def:Mise.Syntax.Stmt.ok", "Mise/Syntax/Ast.lean", 173, 186)

#"One statement is acceptable after the statements summarised by ";#raw("c");#".";

#raw(lang: "lean", block: true, "def Stmt.ok (c : Ctx) : Stmt → Bool\n  | .binding k v => validIdent k && !keywords.contains k.toList && validEval v\n  | .rule r =>\n    validIdent r.name && !c.rules.contains r.name &&\n    r.bindings.all (fun b => validBinding b && ruleKeys.contains b.1) &&\n    -- Ninja keeps the last `command` binding and rejects it if it is empty.\n    ((r.bindings.filter (·.1 == \"command\")).getLast?.any fun b => !b.2.isEmpty)\n  | .edge e =>\n    validIdent e.rule && c.rules.contains e.rule && !e.outs.isEmpty &&\n    e.allPaths.all validPath && nodupB e.allOuts &&\n    e.allOuts.all (fun o => !c.outs.contains o) &&\n    e.bindings.all validBinding\n  | .default ps => !ps.isEmpty && ps.all validPath && ps.all c.known.contains")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Ctx"))[#raw("Syntax.Ctx");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Edge.allOuts"))[#raw("Syntax.Edge.allOuts");];, #link(label("def:Mise.Syntax.Edge.allPaths"))[#raw("Syntax.Edge.allPaths");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.keywords"))[#raw("Syntax.keywords");];, #link(label("def:Mise.Syntax.nodupB"))[#raw("Syntax.nodupB");];, #link(label("def:Mise.Syntax.ruleKeys"))[#raw("Syntax.ruleKeys");];, #link(label("def:Mise.Syntax.validBinding"))[#raw("Syntax.validBinding");];, #link(label("def:Mise.Syntax.validEval"))[#raw("Syntax.validEval");];, #link(label("def:Mise.Syntax.validIdent"))[#raw("Syntax.validIdent");];, #link(label("def:Mise.Syntax.validPath"))[#raw("Syntax.validPath");];]

== #raw("Mise/Syntax/Print.lean");

#def-heading("Syntax.escPathChar", "def:Mise.Syntax.escPathChar", "Mise/Syntax/Print.lean", 12, 15)

#"One path character as written in a manifest: ";#raw("$");#", space and ";#raw(":");#" become ";#raw("$$");#", ";#raw("$ ");#" and ";#raw("$:");#"; any other character is written as itself.";

#raw(lang: "lean", block: true, "def escPathChar (c : Char) : List Char :=\n  if c = '$' then ['$', '$'] else if c = ' ' then ['$', ' '] else if c = ':' then ['$', ':'] else [c]")

#def-heading("Syntax.escPath", "def:Mise.Syntax.escPath", "Mise/Syntax/Print.lean", 17, 18)

#"A path with each character escaped by ";#raw("escPathChar");#".";

#raw(lang: "lean", block: true, "def escPath (p : Path) : List Char := p.toList.flatMap escPathChar")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.escPathChar"))[#raw("Syntax.escPathChar");];]

#def-heading("Syntax.escValChar", "def:Mise.Syntax.escValChar", "Mise/Syntax/Print.lean", 20, 22)

#"One character of literal value text: ";#raw("$");#" becomes ";#raw("$$");#"; any other character is written as itself.";

#raw(lang: "lean", block: true, "def escValChar (c : Char) : List Char := if c = '$' then ['$', '$'] else [c]")

#def-heading("Syntax.escLead", "def:Mise.Syntax.escLead", "Mise/Syntax/Print.lean", 24, 28)

#"Escape literal text at the start of a value. Ninja skips spaces after ";#raw("=");#", so a leading space must be written ";#raw("$ ");#".";

#raw(lang: "lean", block: true, "def escLead : List Char → List Char\n  | [] => []\n  | c :: cs => if c = ' ' then '$' :: ' ' :: cs.flatMap escValChar else (c :: cs).flatMap escValChar")
#uses[#link(label("def:Mise.Syntax.escValChar"))[#raw("Syntax.escValChar");];]

#def-heading("Syntax.renderSeg", "def:Mise.Syntax.renderSeg", "Mise/Syntax/Print.lean", 30, 34)

#"A value segment as text: literal text with ";#raw("$");#" escaped, or a variable reference written ";#raw("${name}");#".";

#raw(lang: "lean", block: true, "def renderSeg : Seg → List Char\n  | .lit s => s.toList.flatMap escValChar\n  | .var n => '$' :: '{' :: (n.toList ++ ['}'])")
#uses[#link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.escValChar"))[#raw("Syntax.escValChar");];]

#def-heading("Syntax.renderVal", "def:Mise.Syntax.renderVal", "Mise/Syntax/Print.lean", 36, 41)

#"A value as text. A leading literal segment goes through ";#raw("escLead");#", so a leading space is kept; the other segments go through ";#raw("renderSeg");#".";

#raw(lang: "lean", block: true, "def renderVal : EvalString → List Char\n  | [] => []\n  | .lit s :: rest => escLead s.toList ++ rest.flatMap renderSeg\n  | .var n :: rest => renderSeg (.var n) ++ rest.flatMap renderSeg")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.escLead"))[#raw("Syntax.escLead");];, #link(label("def:Mise.Syntax.renderSeg"))[#raw("Syntax.renderSeg");];]

#def-heading("Syntax.pathList", "def:Mise.Syntax.pathList", "Mise/Syntax/Print.lean", 43, 44)

#"Each path preceded by a space.";

#raw(lang: "lean", block: true, "def pathList (ps : List Path) : List Char := ps.flatMap (fun p => ' ' :: escPath p)")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.escPath"))[#raw("Syntax.escPath");];]

#def-heading("Syntax.pathSection", "def:Mise.Syntax.pathSection", "Mise/Syntax/Print.lean", 46, 48)

#"An optional ";#raw("|");#" or ";#raw("||");#" section.";

#raw(lang: "lean", block: true, "def pathSection (sep : List Char) (ps : List Path) : List Char :=\n  if ps.isEmpty then [] else ' ' :: sep ++ pathList ps")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.pathList"))[#raw("Syntax.pathList");];]

#def-heading("Syntax.bindingLine", "def:Mise.Syntax.bindingLine", "Mise/Syntax/Print.lean", 50, 52)

#"The line ";#raw("key = value");#", indented by two spaces when ";#raw("indent");#" is true.";

#raw(lang: "lean", block: true, "def bindingLine (indent : Bool) (b : Binding) : List Char :=\n  (if indent then [' ', ' '] else []) ++ b.1.toList ++ [' ', '=', ' '] ++ renderVal b.2")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.renderVal"))[#raw("Syntax.renderVal");];]

#def-heading("Syntax.edgeLine", "def:Mise.Syntax.edgeLine", "Mise/Syntax/Print.lean", 54, 60)

#"The ";#raw("build");#" line of an edge: outputs, ";#raw("|");#" and implicit outputs, ";#raw(":");#", the rule, inputs, ";#raw("|");#" and implicit inputs, ";#raw("||");#" and order-only inputs. An empty ";#raw("|");#" or ";#raw("||");#" section is left out. The edge's bindings are not on this line.";

#raw(lang: "lean", block: true, "def edgeLine (e : Edge) : List Char :=\n  ['b', 'u', 'i', 'l', 'd'] ++ pathList e.outs ++ pathSection ['|'] e.implicitOuts ++\n    [':', ' '] ++ e.rule.toList ++ pathList e.ins ++ pathSection ['|'] e.implicitIns ++\n    pathSection ['|', '|'] e.orderOnly")
#uses[#link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.pathList"))[#raw("Syntax.pathList");];, #link(label("def:Mise.Syntax.pathSection"))[#raw("Syntax.pathSection");];]

#def-heading("Syntax.printStmt", "def:Mise.Syntax.printStmt", "Mise/Syntax/Print.lean", 62, 68)

#"The lines of one statement. A rule is followed by its indented bindings and a blank line, and an edge by its indented bindings.";

#raw(lang: "lean", block: true, "def printStmt : Stmt → List (List Char)\n  | .binding k v => [bindingLine false (k, v)]\n  | .rule r => (['r', 'u', 'l', 'e', ' '] ++ r.name.toList) :: r.bindings.map (bindingLine true) ++ [[]]\n  | .edge e => edgeLine e :: e.bindings.map (bindingLine true)\n  | .default ps => (['d', 'e', 'f', 'a', 'u', 'l', 't'] ++ pathList ps) :: []")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.bindingLine"))[#raw("Syntax.bindingLine");];, #link(label("def:Mise.Syntax.edgeLine"))[#raw("Syntax.edgeLine");];, #link(label("def:Mise.Syntax.pathList"))[#raw("Syntax.pathList");];]

#def-heading("Syntax.headerLine", "def:Mise.Syntax.headerLine", "Mise/Syntax/Print.lean", 70, 71)

#"The comment line at the top of every manifest ";#raw("mise");#" writes.";

#raw(lang: "lean", block: true, "def headerLine : List Char := \"# Generated by mise. Do not edit.\".toList")

#def-heading("Syntax.printLines", "def:Mise.Syntax.printLines", "Mise/Syntax/Print.lean", 73, 75)

#"The lines of a manifest: the header comment, then the lines of each statement in order.";

#raw(lang: "lean", block: true, "def printLines (m : Manifest) : List (List Char) := headerLine :: m.stmts.flatMap printStmt")
#uses[#link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.headerLine"))[#raw("Syntax.headerLine");];, #link(label("def:Mise.Syntax.printStmt"))[#raw("Syntax.printStmt");];]

#def-heading("Syntax.printChars", "def:Mise.Syntax.printChars", "Mise/Syntax/Print.lean", 77, 78)

#"The lines of a manifest, each followed by a newline.";

#raw(lang: "lean", block: true, "def printChars (m : Manifest) : List Char := (printLines m).flatMap (· ++ ['\\n'])")
#uses[#link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.printLines"))[#raw("Syntax.printLines");];]

#def-heading("Syntax.print", "def:Mise.Syntax.print", "Mise/Syntax/Print.lean", 80, 82)

#"The text of a manifest, as ";#raw("mise");#" writes it.";

#template("Template", "the text of {m}")

#raw(lang: "lean", block: true, "def print (m : Manifest) : String := String.ofList (printChars m)")
#uses[#link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.printChars"))[#raw("Syntax.printChars");];]

== #raw("Mise/Syntax/Parse.lean");

#def-heading("Syntax.eatSpaces", "def:Mise.Syntax.eatSpaces", "Mise/Syntax/Parse.lean", 16, 19)

#"Drop leading spaces.";

#raw(lang: "lean", block: true, "def eatSpaces : List Char → List Char\n  | [] => []\n  | c :: r => if c = ' ' then eatSpaces r else c :: r")

#def-heading("Syntax.spanWhile", "def:Mise.Syntax.spanWhile", "Mise/Syntax/Parse.lean", 21, 24)

#"Split a list before the first character that fails ";#raw("p");#".";

#raw(lang: "lean", block: true, "def spanWhile (p : Char → Bool) : List Char → List Char × List Char\n  | [] => ([], [])\n  | c :: r => if p c then ((spanWhile p r).1.cons c, (spanWhile p r).2) else ([], c :: r)")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];]

#def-heading("Syntax.readIdent", "def:Mise.Syntax.readIdent", "Mise/Syntax/Parse.lean", 26, 30)

#"Ninja's ";#raw("ReadIdent");#": a nonempty ";#raw("varname");#", then any spaces.";

#raw(lang: "lean", block: true, "def readIdent (l : List Char) : Option (List Char × List Char) :=\n  match spanWhile isVarChar l with\n  | ([], _) => none\n  | (w, r) => some (w, eatSpaces r)")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.isVarChar"))[#raw("Syntax.isVarChar");];, #link(label("def:Mise.Syntax.spanWhile"))[#raw("Syntax.spanWhile");];]

#def-heading("Syntax.readPath", "def:Mise.Syntax.readPath", "Mise/Syntax/Parse.lean", 32, 46)

#"One path, in Ninja's path mode. It stops before an unescaped space, ";#raw(":");#" or ";#raw("|");#", or at the end of the line. A variable reference in a path is outside the model.";

#raw(lang: "lean", block: true, "def readPath : List Char → Option (List Char × List Char)\n  | [] => some ([], [])\n  | c :: r =>\n    if c = '$' then\n      match r with\n      | [] => none\n      | d :: r' =>\n        if d = '$' || d = ' ' || d = ':' then (readPath r').map (fun x => (d :: x.1, x.2))\n        else none\n    else if c = ' ' || c = ':' || c = '|' then some ([], c :: r)\n    else if litChar c then (readPath r).map (fun x => (c :: x.1, x.2))\n    else none")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.litChar"))[#raw("Syntax.litChar");];]

#def-heading("Syntax.readPaths", "def:Mise.Syntax.readPaths", "Mise/Syntax/Parse.lean", 83, 93)

#"Paths separated by spaces, up to the first empty path.";

#raw(lang: "lean", block: true, "def readPaths (l : List Char) : Option (List (List Char) × List Char) :=\n  match _h : readPath l with\n  | none => none\n  | some ([], r) => some ([], r)\n  | some (c :: p, r) => (readPaths (eatSpaces r)).map (fun x => ((c :: p) :: x.1, x.2))\ntermination_by l.length\ndecreasing_by\n  have h1 := readPath_length _h\n  have h2 := eatSpaces_length r\n  simp at h1 ⊢; omega")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.readPath"))[#raw("Syntax.readPath");];]

#def-heading("Syntax.consLit", "def:Mise.Syntax.consLit", "Mise/Syntax/Parse.lean", 95, 99)

#"Merge one literal character into the front of an evaluated string.";

#raw(lang: "lean", block: true, "def consLit (c : Char) (t : EvalString) : EvalString :=\n  match t with\n  | .lit s :: t' => .lit (String.ofList (c :: s.toList)) :: t'\n  | _ => .lit (String.ofList [c]) :: t")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Syntax.readValue", "def:Mise.Syntax.readValue", "Mise/Syntax/Parse.lean", 101, 130)

#"A value, in Ninja's value mode, running to the end of the line.";

#raw(lang: "lean", block: true, "def readValue (l : List Char) : Option EvalString :=\n  match l with\n  | [] => some []\n  | c :: r =>\n    if c = '$' then\n      match r with\n      | [] => none\n      | d :: r' =>\n        if d = '$' || d = ' ' || d = ':' then (readValue r').map (consLit d)\n        else if d = '{' then\n          match _h : spanWhile isVarChar r' with\n          | (n, e :: r'') =>\n            if e = '}' && !n.isEmpty then\n              (readValue r'').map (Seg.var (String.ofList n) :: ·)\n            else none\n          | (_, []) => none\n        else if isSimpleVarChar d then\n          match _h : spanWhile isSimpleVarChar r' with\n          | (n, r'') => (readValue r'').map (Seg.var (String.ofList (d :: n)) :: ·)\n        else none\n    else if litChar c then (readValue r).map (consLit c)\n    else none\ntermination_by l.length\ndecreasing_by\n  all_goals simp\n  all_goals first\n    | omega\n    | (have := spanWhile_length isVarChar r'; rw [_h] at this; simp at this; omega)\n    | (have := spanWhile_length isSimpleVarChar r'; rw [_h] at this; simp at this; omega)")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.consLit"))[#raw("Syntax.consLit");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.isSimpleVarChar"))[#raw("Syntax.isSimpleVarChar");];, #link(label("def:Mise.Syntax.isVarChar"))[#raw("Syntax.isVarChar");];, #link(label("def:Mise.Syntax.litChar"))[#raw("Syntax.litChar");];, #link(label("def:Mise.Syntax.spanWhile"))[#raw("Syntax.spanWhile");];]

#def-heading("Syntax.parseLet", "def:Mise.Syntax.parseLet", "Mise/Syntax/Parse.lean", 132, 137)

#"Ninja's ";#raw("ParseLet");#" on the text after any indentation: ";#raw("key = value");#".";

#raw(lang: "lean", block: true, "def parseLet (l : List Char) : Option Binding := do\n  let (k, r) ← readIdent l\n  match r with\n  | c :: v => if c = '=' then (readValue (eatSpaces v)).map (String.ofList k, ·) else none\n  | [] => none")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.readIdent"))[#raw("Syntax.readIdent");];, #link(label("def:Mise.Syntax.readValue"))[#raw("Syntax.readValue");];]

#def-heading("Syntax.section1", "def:Mise.Syntax.section1", "Mise/Syntax/Parse.lean", 139, 145)

#"An optional ";#raw("|");#" section: a single ";#raw("|");#", not ";#raw("||");#" or ";#raw("|@");#".";

#raw(lang: "lean", block: true, "def section1 (l : List Char) : Option (List (List Char) × List Char) :=\n  match l with\n  | c :: r =>\n    if c = '|' && r.head? != some '|' && r.head? != some '@' then readPaths (eatSpaces r)\n    else some ([], l)\n  | [] => some ([], [])")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.parseLet"))[#raw("Syntax.parseLet");];, #link(label("def:Mise.Syntax.readPaths"))[#raw("Syntax.readPaths");];]

#def-heading("Syntax.section2", "def:Mise.Syntax.section2", "Mise/Syntax/Parse.lean", 147, 152)

#"An optional ";#raw("||");#" section.";

#raw(lang: "lean", block: true, "def section2 (l : List Char) : Option (List (List Char) × List Char) :=\n  match l with\n  | c :: d :: r =>\n    if c = '|' && d = '|' && r.head? != some '@' then readPaths (eatSpaces r) else some ([], l)\n  | _ => some ([], l)")
#uses[#link(label("def:Mise.Syntax.consLit"))[#raw("Syntax.consLit");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.readPaths"))[#raw("Syntax.readPaths");];]

#def-heading("Syntax.toPaths", "def:Mise.Syntax.toPaths", "Mise/Syntax/Parse.lean", 154, 155)

#"Character lists as paths.";

#raw(lang: "lean", block: true, "def toPaths (ps : List (List Char)) : List Path := ps.map String.ofList")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Syntax.parseEdgeLine", "def:Mise.Syntax.parseEdgeLine", "Mise/Syntax/Parse.lean", 157, 173)

#"A ";#raw("build");#" line after the keyword and its spaces. Bindings come later.";

#raw(lang: "lean", block: true, "def parseEdgeLine (l : List Char) : Option Edge := do\n  let (outs, l) ← readPaths l\n  let (iouts, l) ← section1 l\n  match l with\n  | c :: l =>\n    if c = ':' then do\n      let (rule, l) ← readIdent (eatSpaces l)\n      let (ins, l) ← readPaths l\n      let (iins, l) ← section1 l\n      let (oo, l) ← section2 l\n      if l.isEmpty then\n        pure { outs := toPaths outs, implicitOuts := toPaths iouts, rule := String.ofList rule,\n               ins := toPaths ins, implicitIns := toPaths iins, orderOnly := toPaths oo }\n      else none\n    else none\n  | [] => none")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.parseLet"))[#raw("Syntax.parseLet");];, #link(label("def:Mise.Syntax.readIdent"))[#raw("Syntax.readIdent");];, #link(label("def:Mise.Syntax.readPaths"))[#raw("Syntax.readPaths");];, #link(label("def:Mise.Syntax.section1"))[#raw("Syntax.section1");];, #link(label("def:Mise.Syntax.section2"))[#raw("Syntax.section2");];, #link(label("def:Mise.Syntax.toPaths"))[#raw("Syntax.toPaths");];]

#def-heading("Syntax.Header", "def:Mise.Syntax.Header", "Mise/Syntax/Parse.lean", 175, 180)

#"The first line of a statement.";

#raw(lang: "lean", block: true, "inductive Header where\n  | binding (b : Binding)\n  | rule (name : String)\n  | edge (e : Edge)\n  | default (ps : List Path)")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Syntax.parseHeader", "def:Mise.Syntax.parseHeader", "Mise/Syntax/Parse.lean", 182, 199)

#"Parse the first line of a statement: ";#raw("rule name");#", ";#raw("build …");#", ";#raw("default paths");#", or ";#raw("key = value");#". Fails on any other keyword, on text after a rule name or default targets, and on a line in no such form.";

#raw(lang: "lean", block: true, "def parseHeader (l : List Char) : Option Header := do\n  let (w, r) ← readIdent l\n  if w = ['r', 'u', 'l', 'e'] then\n    let (n, r) ← readIdent r\n    if r.isEmpty then pure (.rule (String.ofList n)) else none\n  else if w = ['b', 'u', 'i', 'l', 'd'] then\n    (parseEdgeLine r).map .edge\n  else if w = ['d', 'e', 'f', 'a', 'u', 'l', 't'] then\n    let (ps, r) ← readPaths r\n    if r.isEmpty then pure (.default (toPaths ps)) else none\n  else if keywords.contains w then none\n  else match r with\n    | c :: v => if c = '=' then (readValue (eatSpaces v)).map (fun e => .binding (String.ofList w, e))\n                else none\n    | [] => none")
#uses[#link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Header"))[#raw("Syntax.Header");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];, #link(label("def:Mise.Syntax.keywords"))[#raw("Syntax.keywords");];, #link(label("def:Mise.Syntax.parseEdgeLine"))[#raw("Syntax.parseEdgeLine");];, #link(label("def:Mise.Syntax.parseLet"))[#raw("Syntax.parseLet");];, #link(label("def:Mise.Syntax.readIdent"))[#raw("Syntax.readIdent");];, #link(label("def:Mise.Syntax.readPaths"))[#raw("Syntax.readPaths");];, #link(label("def:Mise.Syntax.readValue"))[#raw("Syntax.readValue");];, #link(label("def:Mise.Syntax.toPaths"))[#raw("Syntax.toPaths");];]

#def-heading("Syntax.LineKind", "def:Mise.Syntax.LineKind", "Mise/Syntax/Parse.lean", 201, 208)

#"How a line starts: blank (spaces only), a comment (";#raw("#");#" after any spaces), indented (a space, then other text), or at the top level.";

#raw(lang: "lean", block: true, "inductive LineKind where\n  | blank\n  | comment\n  | indented (rest : List Char)\n  | top\n  deriving DecidableEq")

#def-heading("Syntax.classify", "def:Mise.Syntax.classify", "Mise/Syntax/Parse.lean", 210, 218)

#"The ";#raw("LineKind");#" of a line. An indented line keeps its text after the leading spaces.";

#raw(lang: "lean", block: true, "def classify (l : List Char) : LineKind :=\n  match eatSpaces l with\n  | [] => .blank\n  | c :: r =>\n    if c = '#' then .comment\n    else if l.head? = some ' ' then .indented (c :: r)\n    else .top")
#uses[#link(label("def:Mise.Syntax.LineKind"))[#raw("Syntax.LineKind");];, #link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];]

#def-heading("Syntax.takeBlock", "def:Mise.Syntax.takeBlock", "Mise/Syntax/Parse.lean", 220, 228)

#"The indented lines after a header, skipping comment lines. A blank line or an unindented line ends the block.";

#raw(lang: "lean", block: true, "def takeBlock : List (List Char) → List (List Char) × List (List Char)\n  | [] => ([], [])\n  | l :: ls =>\n    match classify l with\n    | .comment => takeBlock ls\n    | .indented r => ((takeBlock ls).1.cons r, (takeBlock ls).2)\n    | _ => ([], l :: ls)")
#uses[#link(label("def:Mise.Syntax.LineKind"))[#raw("Syntax.LineKind");];, #link(label("def:Mise.Syntax.classify"))[#raw("Syntax.classify");];]

#def-heading("Syntax.finishStmt", "def:Mise.Syntax.finishStmt", "Mise/Syntax/Parse.lean", 235, 241)

#"Combine a header with its block of indented lines.";

#raw(lang: "lean", block: true, "def finishStmt : Header → List (List Char) → Option Stmt\n  | .binding b, [] => some (.binding b.1 b.2)\n  | .default ps, [] => some (.default ps)\n  | .rule n, blk => (blk.mapM parseLet).map (fun bs => .rule ⟨n, bs⟩)\n  | .edge e, blk => (blk.mapM parseLet).map (fun bs => .edge { e with bindings := bs })\n  | _, _ :: _ => none")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Header"))[#raw("Syntax.Header");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.parseLet"))[#raw("Syntax.parseLet");];]

#def-heading("Syntax.parseLines", "def:Mise.Syntax.parseLines", "Mise/Syntax/Parse.lean", 243, 268)

#"Parse lines into statements, after the statements ";#raw("acc");#" already read with context ";#raw("c");#". Blank and comment lines are skipped, and an indented line outside a statement fails. Each statement must pass ";#raw("Stmt.ok");#" in the context of the statements before it.";

#raw(lang: "lean", block: true, "def parseLines (ls : List (List Char)) (c : Ctx) (acc : List Stmt) : Option (List Stmt) :=\n  match ls with\n  | [] => some acc\n  | l :: ls =>\n    match classify l with\n    | .blank => parseLines ls c acc\n    | .comment => parseLines ls c acc\n    | .indented _ => none\n    | .top =>\n      match parseHeader l with\n      | none => none\n      | some h =>\n        match _hb : takeBlock ls with\n        | (blk, rest) =>\n          match finishStmt h blk with\n          | none => none\n          | some s => if s.ok c then parseLines rest (c.add s) (acc ++ [s]) else none\ntermination_by ls.length\ndecreasing_by\n  all_goals first\n    | (simp; done)\n    | (have := takeBlock_length ls; rw [_hb] at this; simp at this ⊢; omega)")
#uses[#link(label("def:Mise.Syntax.Ctx"))[#raw("Syntax.Ctx");];, #link(label("def:Mise.Syntax.Ctx.add"))[#raw("Syntax.Ctx.add");];, #link(label("def:Mise.Syntax.Header"))[#raw("Syntax.Header");];, #link(label("def:Mise.Syntax.LineKind"))[#raw("Syntax.LineKind");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.Stmt.ok"))[#raw("Syntax.Stmt.ok");];, #link(label("def:Mise.Syntax.classify"))[#raw("Syntax.classify");];, #link(label("def:Mise.Syntax.finishStmt"))[#raw("Syntax.finishStmt");];, #link(label("def:Mise.Syntax.parseHeader"))[#raw("Syntax.parseHeader");];, #link(label("def:Mise.Syntax.takeBlock"))[#raw("Syntax.takeBlock");];]

#def-heading("Syntax.splitLines", "def:Mise.Syntax.splitLines", "Mise/Syntax/Parse.lean", 270, 278)

#"Split a character list at every newline. The result has one more element than there are newlines.";

#raw(lang: "lean", block: true, "def splitLines : List Char → List (List Char)\n  | [] => [[]]\n  | c :: r =>\n    if c = '\\n' then [] :: splitLines r\n    else match splitLines r with\n      | l :: ls => (c :: l) :: ls\n      | [] => [[c]]")
#uses[#link(label("def:Mise.Syntax.eatSpaces"))[#raw("Syntax.eatSpaces");];]

#def-heading("Syntax.parseChars", "def:Mise.Syntax.parseChars", "Mise/Syntax/Parse.lean", 280, 283)

#"Parse a whole manifest, starting from the context that knows only the ";#raw("phony");#" rule; ";#raw("none");#" if any line fails.";

#raw(lang: "lean", block: true, "def parseChars (cs : List Char) : Option Manifest :=\n  (parseLines (splitLines cs) {} []).map Manifest.mk")
#uses[#link(label("def:Mise.Syntax.Ctx"))[#raw("Syntax.Ctx");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.parseLines"))[#raw("Syntax.parseLines");];, #link(label("def:Mise.Syntax.splitLines"))[#raw("Syntax.splitLines");];]

#def-heading("Syntax.parse", "def:Mise.Syntax.parse", "Mise/Syntax/Parse.lean", 285, 288)

#"The parser model: the manifest the text describes, or ";#raw("none");#" when the model rejects the text.";

#template("Template", "the result of parsing {s}")

#raw(lang: "lean", block: true, "def parse (s : String) : Option Manifest := parseChars s.toList")
#uses[#link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.parseChars"))[#raw("Syntax.parseChars");];]

== #raw("Mise/Frontend/Eval.lean");

#def-heading("Syntax.Scope", "def:Mise.Syntax.Scope", "Mise/Frontend/Eval.lean", 25, 26)

#"A scope: evaluated bindings, newest first.";

#raw(lang: "lean", block: true, "abbrev Scope := List (String × String)")

#def-heading("Syntax.Scope.get", "def:Mise.Syntax.Scope.get", "Mise/Frontend/Eval.lean", 28, 29)

#"The newest binding of ";#raw("k");#" in the scope, if there is one.";

#raw(lang: "lean", block: true, "def Scope.get (s : Scope) (k : String) : Option String := (s.find? (·.1 == k)).map (·.2)")
#uses[#link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.evalWith", "def:Mise.Syntax.evalWith", "Mise/Frontend/Eval.lean", 31, 35)

#"Evaluate a value, looking variables up with ";#raw("look");#".";

#raw(lang: "lean", block: true, "def evalWith (look : String → String) : EvalString → String\n  | [] => \"\"\n  | .lit s :: r => s ++ evalWith look r\n  | .var n :: r => look n ++ evalWith look r")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Syntax.shellSafe", "def:Mise.Syntax.shellSafe", "Mise/Frontend/Eval.lean", 37, 39)

#"Characters Ninja's ";#raw("IsKnownShellSafeCharacter");#" accepts.";

#raw(lang: "lean", block: true, "def shellSafe (c : Char) : Bool :=\n  c.isAlphanum || c == '_' || c == '+' || c == '-' || c == '.' || c == '/'")

#def-heading("Syntax.shellEscape", "def:Mise.Syntax.shellEscape", "Mise/Frontend/Eval.lean", 41, 44)

#"Ninja's ";#raw("GetShellEscapedString");#" for POSIX shells.";

#raw(lang: "lean", block: true, "def shellEscape (s : String) : String :=\n  if s.toList.all shellSafe then s\n  else String.ofList ('\\'' :: (s.toList.flatMap fun c => if c = '\\'' then \"'\\\\''\".toList else [c]) ++ ['\\''])")
#uses[#link(label("def:Mise.Syntax.shellSafe"))[#raw("Syntax.shellSafe");];]

#def-heading("Syntax.shellList", "def:Mise.Syntax.shellList", "Mise/Frontend/Eval.lean", 46, 47)

#"Ninja's ";#raw("MakePathList");#" with shell escaping.";

#raw(lang: "lean", block: true, "def shellList (sep : String) (ps : List Path) : String := sep.intercalate (ps.map shellEscape)")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.shellEscape"))[#raw("Syntax.shellEscape");];]

#def-heading("Syntax.Rule.get", "def:Mise.Syntax.Rule.get", "Mise/Frontend/Eval.lean", 49, 50)

#"The last binding of ";#raw("k");#" in a rule.";

#raw(lang: "lean", block: true, "def Rule.get (r : Rule) (k : String) : Option EvalString := (r.bindings.reverse.find? (·.1 == k)).map (·.2)")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];]

#def-heading("Syntax.EdgeInfo", "def:Mise.Syntax.EdgeInfo", "Mise/Frontend/Eval.lean", 52, 59)

#"What Ninja stores for an edge after parsing it.";

#raw(lang: "lean", block: true, "structure EdgeInfo where\n  edge : Edge\n  rule : Rule\n  /-- The edge's own scope, or `none` when the edge has no bindings and uses\n  the file scope. -/\n  own : Option Scope\n  deriving Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.EdgeInfo.lookup", "def:Mise.Syntax.EdgeInfo.lookup", "Mise/Frontend/Eval.lean", 61, 72)

#"Look up a variable on an edge. ";#raw("file");#" is the final file scope.";

#raw(lang: "lean", block: true, "def EdgeInfo.lookup (file : Scope) (c : EdgeInfo) : Nat → String → String\n  | fuel, v =>\n    if v = \"in\" then shellList \" \" c.edge.ins\n    else if v = \"in_newline\" then shellList \"\\n\" c.edge.ins\n    else if v = \"out\" then shellList \" \" c.edge.outs\n    else match (c.own.getD file).get v with\n      | some s => s\n      | none => match c.rule.get v, fuel with\n        | some ev, fuel + 1 => evalWith (c.lookup file fuel) ev\n        | some _, 0 => \"\"\n        | none, _ => if c.own.isSome then (file.get v).getD \"\" else \"\"")
#uses[#link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Rule.get"))[#raw("Syntax.Rule.get");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];, #link(label("def:Mise.Syntax.Scope.get"))[#raw("Syntax.Scope.get");];, #link(label("def:Mise.Syntax.evalWith"))[#raw("Syntax.evalWith");];, #link(label("def:Mise.Syntax.shellList"))[#raw("Syntax.shellList");];]

#def-heading("Syntax.EdgeInfo.binding", "def:Mise.Syntax.EdgeInfo.binding", "Mise/Frontend/Eval.lean", 74, 76)

#"An evaluated edge variable, with enough fuel for any acyclic rule.";

#raw(lang: "lean", block: true, "def EdgeInfo.binding (file : Scope) (c : EdgeInfo) (k : String) : String :=\n  c.lookup file (c.rule.bindings.length + 1) k")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.lookup"))[#raw("Syntax.EdgeInfo.lookup");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.EdgeInfo.command", "def:Mise.Syntax.EdgeInfo.command", "Mise/Frontend/Eval.lean", 78, 79)

#"The evaluated command, as Ninja hashes it in the build log.";

#raw(lang: "lean", block: true, "def EdgeInfo.command (file : Scope) (c : EdgeInfo) : String := c.binding file \"command\"")
#uses[#link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.binding"))[#raw("Syntax.EdgeInfo.binding");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.EdgeInfo.isDyn", "def:Mise.Syntax.EdgeInfo.isDyn", "Mise/Frontend/Eval.lean", 81, 83)

#"Whether Ninja reads the edge's dependencies from its deps log (";#raw("deps = gcc");#"): Ninja checks only that the binding is nonempty.";

#raw(lang: "lean", block: true, "def EdgeInfo.isDyn (file : Scope) (c : EdgeInfo) : Bool := c.binding file \"deps\" != \"\"")
#uses[#link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.binding"))[#raw("Syntax.EdgeInfo.binding");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.EdgeInfo.isRestat", "def:Mise.Syntax.EdgeInfo.isRestat", "Mise/Frontend/Eval.lean", 85, 87)

#"Whether Ninja re-reads the outputs' mtimes after the command (";#raw("restat");#"): Ninja checks only that the binding is nonempty.";

#raw(lang: "lean", block: true, "def EdgeInfo.isRestat (file : Scope) (c : EdgeInfo) : Bool := c.binding file \"restat\" != \"\"")
#uses[#link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.binding"))[#raw("Syntax.EdgeInfo.binding");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.Elab", "def:Mise.Syntax.Elab", "Mise/Frontend/Eval.lean", 89, 94)

#"The state of Ninja's parser after reading a prefix of the manifest.";

#raw(lang: "lean", block: true, "structure Elab where\n  file : Scope := []\n  rules : List Rule := [⟨\"phony\", []⟩]\n  edges : List EdgeInfo := []\n  deriving Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.fileLook", "def:Mise.Syntax.fileLook", "Mise/Frontend/Eval.lean", 96, 97)

#"A variable's value in a file scope; an unbound variable is empty.";

#raw(lang: "lean", block: true, "def fileLook (s : Scope) (v : String) : String := (s.get v).getD \"\"")
#uses[#link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];, #link(label("def:Mise.Syntax.Scope.get"))[#raw("Syntax.Scope.get");];]

#def-heading("Syntax.edgeInfo", "def:Mise.Syntax.edgeInfo", "Mise/Frontend/Eval.lean", 99, 104)

#"What Ninja stores for an edge read with the given rules and file scope.";

#raw(lang: "lean", block: true, "def edgeInfo (rules : List Rule) (file : Scope) (e : Edge) : EdgeInfo where\n  edge := e\n  rule := (rules.find? (·.name == e.rule)).getD ⟨e.rule, []⟩\n  own := if e.bindings.isEmpty then none\n    else some (e.bindings.foldl (fun acc b => (b.1, evalWith (fileLook file) b.2) :: acc) [])")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];, #link(label("def:Mise.Syntax.evalWith"))[#raw("Syntax.evalWith");];, #link(label("def:Mise.Syntax.fileLook"))[#raw("Syntax.fileLook");];]

#def-heading("Syntax.Elab.step", "def:Mise.Syntax.Elab.step", "Mise/Frontend/Eval.lean", 106, 114)

#"Ninja's parser state after one more statement. A top-level binding is evaluated in the current file scope and added to it, a rule is added to the rules, an edge is recorded with the current rules and file scope (";#raw("edgeInfo");#"), and ";#raw("default");#" changes nothing.";

#raw(lang: "lean", block: true, "def Elab.step (st : Elab) : Stmt → Elab\n  | .binding k v => { st with file := (k, evalWith (fileLook st.file) v) :: st.file }\n  | .rule r => { st with rules := st.rules ++ [r] }\n  | .edge e => { st with edges := st.edges ++ [edgeInfo st.rules st.file e] }\n  | .default _ => st")
#uses[#link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.Elab"))[#raw("Syntax.Elab");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];, #link(label("def:Mise.Syntax.edgeInfo"))[#raw("Syntax.edgeInfo");];, #link(label("def:Mise.Syntax.evalWith"))[#raw("Syntax.evalWith");];, #link(label("def:Mise.Syntax.fileLook"))[#raw("Syntax.fileLook");];]

#def-heading("Syntax.Manifest.elab", "def:Mise.Syntax.Manifest.elab", "Mise/Frontend/Eval.lean", 116, 118)

#"Ninja's parser state after reading every statement in order, from the state that knows only the ";#raw("phony");#" rule.";

#raw(lang: "lean", block: true, "def Manifest.elab (m : Manifest) : Elab := m.stmts.foldl Elab.step {}")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.Elab"))[#raw("Syntax.Elab");];, #link(label("def:Mise.Syntax.Elab.step"))[#raw("Syntax.Elab.step");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];]

== #raw("Mise/Frontend/Graph.lean");

#def-heading("Frontend.ninjaMinVersion", "def:Mise.Frontend.ninjaMinVersion", "Mise/Frontend/Graph.lean", 22, 25)

#"The oldest Ninja release ";#raw("mise");#" supports. ";#raw("emit");#" writes it first in every manifest as the top-level binding ";#raw("ninja_required_version");#", which makes older releases refuse the manifest.";

#raw(lang: "lean", block: true, "def ninjaMinVersion : String := \"1.12.1\"")

#def-heading("Frontend.versionVar", "def:Mise.Frontend.versionVar", "Mise/Frontend/Graph.lean", 27, 28)

#"The top-level binding Ninja checks its own version against.";

#raw(lang: "lean", block: true, "def versionVar : String := \"ninja_required_version\"")

#def-heading("Frontend.reserved", "def:Mise.Frontend.reserved", "Mise/Frontend/Graph.lean", 30, 33)

#"Names a template or an edge may not use as a variable of its own. Edge bindings with these names would change what Ninja runs, and a template reference to ";#raw("versionVar");#" would read the emitted top-level binding.";

#raw(lang: "lean", block: true, "def reserved : List String := [\"in\", \"out\", \"in_newline\", versionVar] ++ ruleKeys")
#uses[#link(label("def:Mise.Frontend.versionVar"))[#raw("Frontend.versionVar");];, #link(label("def:Mise.Syntax.ruleKeys"))[#raw("Syntax.ruleKeys");];]

#def-heading("Frontend.GRule", "def:Mise.Frontend.GRule", "Mise/Frontend/Graph.lean", 35, 48)

#"A rule. The command and description are Ninja values; ";#raw("${in}");#" and ";#raw("${out}");#" stand for the edge's explicit inputs and outputs, and any other variable is bound by the edge. An empty description is not emitted.";

#raw(lang: "lean", block: true, "structure GRule where\n  name : String\n  command : EvalString\n  description : EvalString := []\n  /-- Emit `depfile = ${out}.d` and `deps = gcc`: the command writes a\n  Makefile-style depfile listing what it read. -/\n  depfile : Bool := false\n  /-- Emit `restat = 1`: the command may leave an output untouched when its\n  contents would not change, and Ninja then skips dependents on its account. -/\n  restat : Bool := false\n  deriving DecidableEq, Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];]

#def-heading("Frontend.GEdge", "def:Mise.Frontend.GEdge", "Mise/Frontend/Graph.lean", 50, 61)

#"An edge in the DSL: the name of its rule, explicit and implicit outputs, explicit, implicit and order-only inputs, and the edge's own variables with their literal values.";

#raw(lang: "lean", block: true, "structure GEdge where\n  rule : String\n  outs : List Path\n  implicitOuts : List Path := []\n  ins : List Path := []\n  implicitIns : List Path := []\n  orderOnly : List Path := []\n  vars : List (String × String) := []\n  deriving DecidableEq, Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.GEdge.allOuts", "def:Mise.Frontend.GEdge.allOuts", "Mise/Frontend/Graph.lean", 65, 66)

#"Explicit then implicit outputs.";

#raw(lang: "lean", block: true, "def allOuts (e : GEdge) : List Path := e.outs ++ e.implicitOuts")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.GEdge.inputs", "def:Mise.Frontend.GEdge.inputs", "Mise/Frontend/Graph.lean", 67, 68)

#"The inputs the command reads: explicit and implicit.";

#raw(lang: "lean", block: true, "def inputs (e : GEdge) : List Path := e.ins ++ e.implicitIns")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.GEdge.allIns", "def:Mise.Frontend.GEdge.allIns", "Mise/Frontend/Graph.lean", 69, 70)

#"Explicit, implicit and order-only inputs.";

#raw(lang: "lean", block: true, "def allIns (e : GEdge) : List Path := e.ins ++ e.implicitIns ++ e.orderOnly")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.GEdge.look", "def:Mise.Frontend.GEdge.look", "Mise/Frontend/Graph.lean", 72, 76)

#"The value of a variable in this edge's command, as the DSL defines it.";

#raw(lang: "lean", block: true, "def look (e : GEdge) (v : String) : String :=\n  if v = \"in\" then shellList \" \" e.ins\n  else if v = \"out\" then shellList \" \" e.outs\n  else ((e.vars.find? (·.1 == v)).map (·.2)).getD \"\"")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Syntax.shellList"))[#raw("Syntax.shellList");];]

#def-heading("Frontend.Graph", "def:Mise.Frontend.Graph", "Mise/Frontend/Graph.lean", 80, 89)

#"A build as the DSL describes it: declared sources, rules, edges in the order they were added, and default targets.";

#template("Template", "build graphs")

#template("Template, singular", "build graph")

#raw(lang: "lean", block: true, "structure Graph where\n  sources : List Path := []\n  rules : List GRule := []\n  edges : List GEdge := []\n  defaults : List Path := []\n  deriving Repr, Inhabited")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.tmplVarsOK", "def:Mise.Frontend.tmplVarsOK", "Mise/Frontend/Graph.lean", 93, 98)

#"Every variable the template refers to is ";#raw("in");#", ";#raw("out");#", or a name outside ";#raw("reserved");#".";

#raw(lang: "lean", block: true, "def tmplVarsOK (t : EvalString) : Bool :=\n  t.all fun\n    | .var n => n == \"in\" || n == \"out\" || !reserved.contains n\n    | .lit _ => true")
#uses[#link(label("def:Mise.Frontend.reserved"))[#raw("Frontend.reserved");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Frontend.GRule.ok", "def:Mise.Frontend.GRule.ok", "Mise/Frontend/Graph.lean", 100, 105)

#"A rule ";#raw("mise");#" can emit: the name is an identifier other than ";#raw("phony");#", the command is a valid nonempty value whose only reserved variables are ";#raw("in");#" and ";#raw("out");#", and the description is a valid value.";

#raw(lang: "lean", block: true, "def GRule.ok (r : GRule) : Bool :=\n  validIdent r.name && r.name != \"phony\" && validEval r.command && !r.command.isEmpty &&\n    tmplVarsOK r.command && validEval r.description")
#uses[#link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.tmplVarsOK"))[#raw("Frontend.tmplVarsOK");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.validEval"))[#raw("Syntax.validEval");];, #link(label("def:Mise.Syntax.validIdent"))[#raw("Syntax.validIdent");];]

#def-heading("Frontend.varsOK", "def:Mise.Frontend.varsOK", "Mise/Frontend/Graph.lean", 107, 111)

#"Edge variables ";#raw("mise");#" can emit: no name occurs twice, every name is an identifier outside ";#raw("reserved");#", and no value contains a newline, carriage return or NUL.";

#raw(lang: "lean", block: true, "def varsOK (vs : List (String × String)) : Bool :=\n  nodupB (vs.map (·.1)) && vs.all fun b => validIdent b.1 && !reserved.contains b.1 && b.2.toList.all litChar")
#uses[#link(label("def:Mise.Frontend.reserved"))[#raw("Frontend.reserved");];, #link(label("def:Mise.Syntax.litChar"))[#raw("Syntax.litChar");];, #link(label("def:Mise.Syntax.nodupB"))[#raw("Syntax.nodupB");];, #link(label("def:Mise.Syntax.validIdent"))[#raw("Syntax.validIdent");];]

#def-heading("Frontend.GEdge.ok", "def:Mise.Frontend.GEdge.ok", "Mise/Frontend/Graph.lean", 113, 117)

#"An edge is acceptable after the edges whose outputs are ";#raw("prev");#".";

#raw(lang: "lean", block: true, "def GEdge.ok (names : List String) (srcs prev : List Path) (e : GEdge) : Bool :=\n  names.contains e.rule && !e.outs.isEmpty && (e.allOuts ++ e.allIns).all validPath &&\n    nodupB e.allOuts && e.allOuts.all (fun o => !prev.contains o && !srcs.contains o) &&\n    e.allIns.all (fun i => srcs.contains i || prev.contains i) && varsOK e.vars")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allIns"))[#raw("Frontend.GEdge.allIns");];, #link(label("def:Mise.Frontend.GEdge.allOuts"))[#raw("Frontend.GEdge.allOuts");];, #link(label("def:Mise.Frontend.varsOK"))[#raw("Frontend.varsOK");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.nodupB"))[#raw("Syntax.nodupB");];, #link(label("def:Mise.Syntax.validPath"))[#raw("Syntax.validPath");];]

#def-heading("Frontend.edgesOK", "def:Mise.Frontend.edgesOK", "Mise/Frontend/Graph.lean", 119, 123)

#"Each edge is acceptable (";#raw("GEdge.ok");#") after the ones before it. The list of paths holds the outputs of the edges already checked.";

#raw(lang: "lean", block: true, "def edgesOK (names : List String) (srcs : List Path) : List Path → List GEdge → Bool\n  | _, [] => true\n  | prev, e :: es => e.ok names srcs prev && edgesOK names srcs (prev ++ e.allOuts) es")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allOuts"))[#raw("Frontend.GEdge.allOuts");];, #link(label("def:Mise.Frontend.GEdge.ok"))[#raw("Frontend.GEdge.ok");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.Graph.ruleNames", "def:Mise.Frontend.Graph.ruleNames", "Mise/Frontend/Graph.lean", 125, 126)

#"The names of the graph's rules, in order.";

#raw(lang: "lean", block: true, "def Graph.ruleNames (g : Graph) : List String := g.rules.map (·.name)")
#uses[#link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];]

#def-heading("Frontend.depfileOutsOK", "def:Mise.Frontend.depfileOutsOK", "Mise/Frontend/Graph.lean", 128, 134)

#"An edge whose rule has a depfile has one explicit output. The depfile is ";#raw("${out}.d");#", which names one file only for one output; with more, Ninja finds no depfile, treats it as empty and records no deps.";

#raw(lang: "lean", block: true, "def depfileOutsOK (rules : List GRule) (e : GEdge) : Bool :=\n  match rules.find? (·.name == e.rule) with\n  | some r => !r.depfile || e.outs.length == 1\n  | none => true")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.Graph.check", "def:Mise.Frontend.Graph.check", "Mise/Frontend/Graph.lean", 136, 143)

#"The validity check: rule names are distinct, every rule is acceptable (";#raw("GRule.ok");#"), every edge is acceptable after the ones before it (";#raw("edgesOK");#"), every default target is an output of some edge, and every edge whose rule has a depfile has one explicit output (";#raw("depfileOutsOK");#").";

#raw(lang: "lean", block: true, "def Graph.check (g : Graph) : Bool :=\n  nodupB g.ruleNames && g.rules.all GRule.ok && edgesOK g.ruleNames g.sources [] g.edges &&\n    (g.defaults.all fun d => g.edges.any (·.allOuts.contains d)) && g.edges.all (depfileOutsOK g.rules)")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allOuts"))[#raw("Frontend.GEdge.allOuts");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.GRule.ok"))[#raw("Frontend.GRule.ok");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.ruleNames"))[#raw("Frontend.Graph.ruleNames");];, #link(label("def:Mise.Frontend.depfileOutsOK"))[#raw("Frontend.depfileOutsOK");];, #link(label("def:Mise.Frontend.edgesOK"))[#raw("Frontend.edgesOK");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.nodupB"))[#raw("Syntax.nodupB");];]

#def-heading("Frontend.Graph.Valid", "def:Mise.Frontend.Graph.Valid", "Mise/Frontend/Graph.lean", 145, 149)

#"Every input is a declared source or an output of an earlier edge, every output has one producer, every name and path can be written in Ninja, and every depfile edge has one explicit output.";

#template("Template", "{g} is valid")

#raw(lang: "lean", block: true, "def Graph.Valid (g : Graph) : Prop := g.check = true")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.check"))[#raw("Frontend.Graph.check");];]

#def-heading("Frontend.findOut", "def:Mise.Frontend.findOut", "Mise/Frontend/Graph.lean", 155, 158)

#"The first element whose outputs contain ";#raw("k");#", with its index.";

#raw(lang: "lean", block: true, "def findOut {α : Type} (outs : α → List Path) (k : Path) : List α → Option (Nat × α)\n  | [] => none\n  | a :: as => if (outs a).contains k then some (0, a) else (findOut outs k as).map fun p => (p.1 + 1, p.2)")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.fetchAll", "def:Mise.Frontend.fetchAll", "Mise/Frontend/Graph.lean", 160, 163)

#"Fetch keys in order.";

#raw(lang: "lean", block: true, "def fetchAll {K V : Type} : List K → Task K V (List V)\n  | [] => .pure []\n  | k :: ks => .fetch k fun v => (fetchAll ks).bind fun vs => .pure (v :: vs)")
#uses[#link(label("def:Mise.Frontend.findOut"))[#raw("Frontend.findOut");];, #link(label("def:Mise.Task"))[#raw("Task");];, #link(label("def:Mise.Task.bind"))[#raw("Task.bind");];]

#def-heading("Frontend.Sem", "def:Mise.Frontend.Sem", "Mise/Frontend/Graph.lean", 165, 178)

#"What commands mean.";

#template("Template", "command meanings over {V}")

#template("Template, singular", "command meaning")

#raw(lang: "lean", block: true, "structure Sem (V : Type) where\n  /-- A static command's outputs from its inputs' contents. -/\n  exec : String → List V → List V\n  /-- A depfile command: what it reads, and its outputs. -/\n  dyn : String → Task Path V (List V)\n  /-- Stage 7: when a `restat` command would write `new` over `old`, it may\n  leave the file untouched when `keep old new` holds. -/\n  keep : V → V → Bool := fun _ _ => false\n  /-- The assumption behind early cutoff: a command leaves a file untouched\n  only when its new contents would be identical. -/\n  keep_eq : ∀ a b, keep a b = true → a = b := by intro a b h; simp at h")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];]

#def-heading("Frontend.Sem.withCmp", "def:Mise.Frontend.Sem.withCmp", "Mise/Frontend/Graph.lean", 180, 186)

#"The semantics of a build whose ";#raw("restat");#" commands go through the DSL's command wrapper (";#raw("wrapCommand");#"), which compares with ";#raw("cmp");#": an output is left untouched exactly when its contents are equal, so ";#raw("keep_eq");#" holds by construction.";

#template("Template", "{sem} with each `restat` output kept exactly when its contents are unchanged")

#raw(lang: "lean", block: true, "def Sem.withCmp {V : Type} [DecidableEq V] (sem : Sem V) : Sem V :=\n  { sem with keep := fun a b => decide (a = b), keep_eq := fun _ _ h => of_decide_eq_true h }")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];]

#def-heading("Frontend.cmdTask", "def:Mise.Frontend.cmdTask", "Mise/Frontend/Graph.lean", 188, 191)

#"A command as a task returning all its outputs. A static command fetches its explicit and implicit inputs in order.";

#raw(lang: "lean", block: true, "def cmdTask {V : Type} (sem : Sem V) (dyn : Bool) (cmd : String) (ins : List Path) : Task Path V (List V) :=\n  if dyn then sem.dyn cmd else (fetchAll ins).bind fun vs => .pure (sem.exec cmd vs)")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Frontend.fetchAll"))[#raw("Frontend.fetchAll");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];, #link(label("def:Mise.Task.bind"))[#raw("Task.bind");];]

#def-heading("Frontend.outTask", "def:Mise.Frontend.outTask", "Mise/Frontend/Graph.lean", 193, 195)

#"Output ";#raw("i");#" of a command.";

#raw(lang: "lean", block: true, "def outTask {V : Type} [Inhabited V] (t : Task Path V (List V)) (i : Nat) : Task Path V V :=\n  t.bind fun vs => .pure (vs.getD i default)")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];, #link(label("def:Mise.Task.bind"))[#raw("Task.bind");];]

#def-heading("Frontend.Graph.ruleOf", "def:Mise.Frontend.Graph.ruleOf", "Mise/Frontend/Graph.lean", 197, 198)

#"The first rule whose name is the edge's rule name.";

#raw(lang: "lean", block: true, "def Graph.ruleOf (g : Graph) (e : GEdge) : Option GRule := g.rules.find? (·.name == e.rule)")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];]

#def-heading("Frontend.Graph.cmd", "def:Mise.Frontend.Graph.cmd", "Mise/Frontend/Graph.lean", 200, 204)

#"The command the DSL means for an edge.";

#raw(lang: "lean", block: true, "def Graph.cmd (g : Graph) (e : GEdge) : String :=\n  match g.ruleOf e with\n  | some r => evalWith e.look r.command\n  | none => \"\"")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.look"))[#raw("Frontend.GEdge.look");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.ruleOf"))[#raw("Frontend.Graph.ruleOf");];, #link(label("def:Mise.Frontend.depfileOutsOK"))[#raw("Frontend.depfileOutsOK");];, #link(label("def:Mise.Syntax.evalWith"))[#raw("Syntax.evalWith");];]

#def-heading("Frontend.Graph.isDyn", "def:Mise.Frontend.Graph.isDyn", "Mise/Frontend/Graph.lean", 206, 210)

#"Whether an edge's rule has a depfile.";

#raw(lang: "lean", block: true, "def Graph.isDyn (g : Graph) (e : GEdge) : Bool :=\n  match g.ruleOf e with\n  | some r => r.depfile\n  | none => false")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.ruleOf"))[#raw("Frontend.Graph.ruleOf");];, #link(label("def:Mise.Frontend.depfileOutsOK"))[#raw("Frontend.depfileOutsOK");];]

#def-heading("Frontend.Graph.isSource", "def:Mise.Frontend.Graph.isSource", "Mise/Frontend/Graph.lean", 218, 219)

#"Paths no edge produces.";

#raw(lang: "lean", block: true, "def Graph.isSource (g : Graph) (k : Path) : Bool := (findOut GEdge.allOuts k g.edges).isNone")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allOuts"))[#raw("Frontend.GEdge.allOuts");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.findOut"))[#raw("Frontend.findOut");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Frontend.Graph.spec", "def:Mise.Frontend.Graph.spec", "Mise/Frontend/Graph.lean", 223, 229)

#"The meaning of a graph, straight from the DSL.";

#template("Template", "the build specification {g} describes")

#raw(lang: "lean", block: true, "def Graph.spec (sem : Sem V) (g : Graph) : BuildSpec Path V where\n  isSource := g.isSource\n  task k := match findOut GEdge.allOuts k g.edges with\n    | some (_, e) => outTask (cmdTask sem (g.isDyn e) (g.cmd e) e.inputs) (e.allOuts.idxOf k)\n    | none => .pure default")
#uses[#link(label("def:Mise.BuildSpec"))[#raw("BuildSpec");];, #link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allOuts"))[#raw("Frontend.GEdge.allOuts");];, #link(label("def:Mise.Frontend.GEdge.inputs"))[#raw("Frontend.GEdge.inputs");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.cmd"))[#raw("Frontend.Graph.cmd");];, #link(label("def:Mise.Frontend.Graph.isDyn"))[#raw("Frontend.Graph.isDyn");];, #link(label("def:Mise.Frontend.Graph.isSource"))[#raw("Frontend.Graph.isSource");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Frontend.cmdTask"))[#raw("Frontend.cmdTask");];, #link(label("def:Mise.Frontend.findOut"))[#raw("Frontend.findOut");];, #link(label("def:Mise.Frontend.outTask"))[#raw("Frontend.outTask");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];]

#def-heading("Frontend.Graph.DynOK", "def:Mise.Frontend.Graph.DynOK", "Mise/Frontend/Graph.lean", 231, 235)

#"The static-ancestor condition (Stage 6): every depfile command reads only sources and the edge's own inputs, order-only inputs included.";

#template("Template", "every depfile command of {g} reads only sources and its edge's inputs")

#raw(lang: "lean", block: true, "def Graph.DynOK (sem : Sem V) (g : Graph) : Prop :=\n  ∀ e ∈ g.edges, g.isDyn e = true → (sem.dyn (g.cmd e)).FetchesOnly fun k => g.isSource k = true ∨ k ∈ e.allIns")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GEdge.allIns"))[#raw("Frontend.GEdge.allIns");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Graph.cmd"))[#raw("Frontend.Graph.cmd");];, #link(label("def:Mise.Frontend.Graph.isDyn"))[#raw("Frontend.Graph.isDyn");];, #link(label("def:Mise.Frontend.Graph.isSource"))[#raw("Frontend.Graph.isSource");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task.FetchesOnly"))[#raw("Task.FetchesOnly");];]

#def-heading("Frontend.depfileBindings", "def:Mise.Frontend.depfileBindings", "Mise/Frontend/Graph.lean", 239, 240)

#"What a rule with a depfile adds: ";#raw("depfile = ${out}.d");#" and ";#raw("deps = gcc");#".";

#raw(lang: "lean", block: true, "def depfileBindings : List Binding := [(\"depfile\", [.var \"out\", .lit \".d\"]), (\"deps\", [.lit \"gcc\"])]")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Frontend.restatBindings", "def:Mise.Frontend.restatBindings", "Mise/Frontend/Graph.lean", 242, 243)

#"What a rule with ";#raw("restat");#" adds: ";#raw("restat = 1");#".";

#raw(lang: "lean", block: true, "def restatBindings : List Binding := [(\"restat\", [.lit \"1\"])]")
#uses[#link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Frontend.emitRule", "def:Mise.Frontend.emitRule", "Mise/Frontend/Graph.lean", 245, 250)

#"A DSL rule as a Ninja rule: ";#raw("command");#", then ";#raw("description");#" when it is nonempty, then the depfile and ";#raw("restat");#" bindings when the rule asks for them.";

#raw(lang: "lean", block: true, "def emitRule (r : GRule) : Rule :=\n  ⟨r.name, [(\"command\", r.command)] ++ (if r.description.isEmpty then [] else [(\"description\", r.description)]) ++\n    (if r.depfile then depfileBindings else []) ++ (if r.restat then restatBindings else [])⟩")
#uses[#link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.depfileBindings"))[#raw("Frontend.depfileBindings");];, #link(label("def:Mise.Frontend.restatBindings"))[#raw("Frontend.restatBindings");];, #link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Frontend.litVal", "def:Mise.Frontend.litVal", "Mise/Frontend/Graph.lean", 252, 253)

#"A string as a value of literal text. The empty string is the empty value.";

#raw(lang: "lean", block: true, "def litVal (s : String) : EvalString := if s.toList.isEmpty then [] else [.lit s]")
#uses[#link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];]

#def-heading("Frontend.emitEdge", "def:Mise.Frontend.emitEdge", "Mise/Frontend/Graph.lean", 255, 260)

#"A DSL edge as a Ninja edge with the same paths and rule. Each edge variable becomes a binding to its literal value.";

#raw(lang: "lean", block: true, "def emitEdge (e : GEdge) : Edge :=\n  { outs := e.outs, implicitOuts := e.implicitOuts, rule := e.rule, ins := e.ins,\n    implicitIns := e.implicitIns, orderOnly := e.orderOnly,\n    bindings := e.vars.map fun b => (b.1, litVal b.2) }")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.litVal"))[#raw("Frontend.litVal");];, #link(label("def:Mise.Syntax.Binding"))[#raw("Syntax.Binding");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.EvalString"))[#raw("Syntax.EvalString");];]

#def-heading("Frontend.versionStmt", "def:Mise.Frontend.versionStmt", "Mise/Frontend/Graph.lean", 262, 263)

#"The first statement of every emitted manifest.";

#raw(lang: "lean", block: true, "def versionStmt : Stmt := .binding versionVar [.lit ninjaMinVersion]")
#uses[#link(label("def:Mise.Frontend.ninjaMinVersion"))[#raw("Frontend.ninjaMinVersion");];, #link(label("def:Mise.Frontend.versionVar"))[#raw("Frontend.versionVar");];, #link(label("def:Mise.Syntax.Seg"))[#raw("Syntax.Seg");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];]

#def-heading("Frontend.emit", "def:Mise.Frontend.emit", "Mise/Frontend/Graph.lean", 265, 271)

#"The manifest ";#raw("mise");#" writes for a graph: the version statement (";#raw("versionStmt");#"), the rules, then the edges in order, then a ";#raw("default");#" statement if the graph has default targets.";

#template("Template", "the manifest `mise` emits for {g}")

#raw(lang: "lean", block: true, "def emit (g : Graph) : Manifest :=\n  ⟨versionStmt :: (g.rules.map (Stmt.rule ∘ emitRule) ++ g.edges.map (Stmt.edge ∘ emitEdge) ++\n    (if g.defaults.isEmpty then [] else [.default g.defaults]))⟩")
#uses[#link(label("def:Mise.Frontend.GEdge"))[#raw("Frontend.GEdge");];, #link(label("def:Mise.Frontend.GRule"))[#raw("Frontend.GRule");];, #link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.emitEdge"))[#raw("Frontend.emitEdge");];, #link(label("def:Mise.Frontend.emitRule"))[#raw("Frontend.emitRule");];, #link(label("def:Mise.Frontend.versionStmt"))[#raw("Frontend.versionStmt");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Rule"))[#raw("Syntax.Rule");];, #link(label("def:Mise.Syntax.Stmt"))[#raw("Syntax.Stmt");];]

#def-heading("Frontend.denote", "def:Mise.Frontend.denote", "Mise/Frontend/Graph.lean", 273, 283)

#"The meaning of a manifest under the Ninja evaluation model: each output is computed by its edge's evaluated command, which is static or reads a depfile according to the edge's ";#raw("deps");#" binding. Paths no edge produces are sources.";

#template("Template", "the meaning of {m} under the Ninja evaluation model")

#raw(lang: "lean", block: true, "def denote (sem : Sem V) (m : Manifest) : BuildSpec Path V where\n  isSource k := (findOut (·.edge.allOuts) k m.elab.edges).isNone\n  task k := match findOut (·.edge.allOuts) k m.elab.edges with\n    | some (_, c) => outTask (cmdTask sem (c.isDyn m.elab.file) (c.command m.elab.file)\n        (c.edge.ins ++ c.edge.implicitIns)) (c.edge.allOuts.idxOf k)\n    | none => .pure default")
#uses[#link(label("def:Mise.BuildSpec"))[#raw("BuildSpec");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Frontend.cmdTask"))[#raw("Frontend.cmdTask");];, #link(label("def:Mise.Frontend.findOut"))[#raw("Frontend.findOut");];, #link(label("def:Mise.Frontend.outTask"))[#raw("Frontend.outTask");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Edge.allOuts"))[#raw("Syntax.Edge.allOuts");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.command"))[#raw("Syntax.EdgeInfo.command");];, #link(label("def:Mise.Syntax.EdgeInfo.isDyn"))[#raw("Syntax.EdgeInfo.isDyn");];, #link(label("def:Mise.Syntax.Elab"))[#raw("Syntax.Elab");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Manifest.elab"))[#raw("Syntax.Manifest.elab");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];]

== #raw("Mise/Model/Basic.lean");

#def-heading("Model.MEdge", "def:Mise.Model.MEdge", "Mise/Model/Basic.lean", 26, 41)

#"What the model needs from an edge: all outputs, the inputs that count for dirtiness and for a static command (explicit and implicit), the order-only inputs, the evaluated command, whether it has a depfile, and whether it has ";#raw("restat");#".";

#template("Template", "model edges")

#template("Template, singular", "model edge")

#raw(lang: "lean", block: true, "structure MEdge where\n  /-- All outputs, explicit and implicit.\n  Gloss: the outputs of {self} -/\n  outs : List Path\n  ins : List Path\n  oo : List Path := []\n  cmd : String\n  dyn : Bool := false\n  restat : Bool := false\n  deriving DecidableEq, Repr, Inhabited")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.MEdge.reads", "def:Mise.Model.MEdge.reads", "Mise/Model/Basic.lean", 43, 44)

#"Every input Ninja builds before the edge.";

#raw(lang: "lean", block: true, "def MEdge.reads (e : MEdge) : List Path := e.ins ++ e.oo")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.MEdge.task", "def:Mise.Model.MEdge.task", "Mise/Model/Basic.lean", 46, 47)

#"The edge's command as a task returning all its outputs.";

#raw(lang: "lean", block: true, "def MEdge.task {V : Type} (sem : Sem V) (e : MEdge) : Task Path V (List V) := cmdTask sem e.dyn e.cmd e.ins")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Frontend.cmdTask"))[#raw("Frontend.cmdTask");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task"))[#raw("Task");];]

#def-heading("Model.toMEdge", "def:Mise.Model.toMEdge", "Mise/Model/Basic.lean", 49, 54)

#"An edge as Ninja stores it, in the model's form: all outputs, explicit and implicit inputs, order-only inputs, and the command, ";#raw("deps");#" and ";#raw("restat");#" bindings as Ninja evaluates them with the final file scope ";#raw("file");#".";

#raw(lang: "lean", block: true, "def toMEdge (file : Scope) (c : EdgeInfo) : MEdge :=\n  ⟨c.edge.allOuts, c.edge.ins ++ c.edge.implicitIns, c.edge.orderOnly, c.command file, c.isDyn file,\n    c.isRestat file⟩")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Syntax.Edge"))[#raw("Syntax.Edge");];, #link(label("def:Mise.Syntax.Edge.allOuts"))[#raw("Syntax.Edge.allOuts");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.EdgeInfo.command"))[#raw("Syntax.EdgeInfo.command");];, #link(label("def:Mise.Syntax.EdgeInfo.isDyn"))[#raw("Syntax.EdgeInfo.isDyn");];, #link(label("def:Mise.Syntax.EdgeInfo.isRestat"))[#raw("Syntax.EdgeInfo.isRestat");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Syntax.Scope"))[#raw("Syntax.Scope");];]

#def-heading("Syntax.Manifest.medges", "def:Mise.Syntax.Manifest.medges", "Mise/Model/Basic.lean", 59, 60)

#"The manifest's edges as the model sees them, in manifest order.";

#raw(lang: "lean", block: true, "def medges (m : Manifest) : List Mise.Model.MEdge := m.elab.edges.map (Mise.Model.toMEdge m.elab.file)")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.toMEdge"))[#raw("Model.toMEdge");];, #link(label("def:Mise.Syntax.EdgeInfo"))[#raw("Syntax.EdgeInfo");];, #link(label("def:Mise.Syntax.Elab"))[#raw("Syntax.Elab");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Manifest.elab"))[#raw("Syntax.Manifest.elab");];]

#def-heading("Model.St", "def:Mise.Model.St", "Mise/Model/Basic.lean", 66, 81)

#"File system, build log, deps log and clock. A log entry is the command and the time recorded for the output; a deps entry is the list of paths the command read.";

#template("Template", "model states over {V}")

#template("Template, singular", "model state")

#raw(lang: "lean", block: true, "structure St (V : Type) where\n  /-- Each path's contents and mtime, or `none` when the file is missing.\n  Gloss: the file at {#2} in {self}\n  Gloss.fun: the file system of {self} -/\n  fs : Path → Option (V × Nat)\n  log : Path → Option (String × Nat)\n  deps : Path → Option (List Path) := fun _ => none\n  /-- The current time. Every edit and every command run advances it by\n  one, and stamps what it writes with the new time.\n  Gloss: the clock of {self} -/\n  clock : Nat")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.content", "def:Mise.Model.St.content", "Mise/Model/Basic.lean", 87, 90)

#"Contents; a missing file reads as ";#raw("default");#".";

#template("Template", "the contents of {p} in {st}")

#template("Template, as a function", "the file contents of {st}")

#raw(lang: "lean", block: true, "def content (st : St V) (p : Path) : V := ((st.fs p).map (·.1)).getD default")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.mtime", "def:Mise.Model.St.mtime", "Mise/Model/Basic.lean", 92, 94)

#"Modification time; a missing file has time 0.";

#template("Template", "the mtime of {p} in {st}")

#raw(lang: "lean", block: true, "def mtime (st : St V) (p : Path) : Nat := ((st.fs p).map (·.2)).getD 0")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.newest", "def:Mise.Model.St.newest", "Mise/Model/Basic.lean", 96, 99)

#"The newest mtime among some inputs.";

#raw(lang: "lean", block: true, "def newest (st : St V) : List Path → Nat\n  | [] => 0\n  | p :: ps => max (st.mtime p) (st.newest ps)")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.mtime"))[#raw("Model.St.mtime");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.effIns", "def:Mise.Model.St.effIns", "Mise/Model/Basic.lean", 101, 104)

#"The inputs Ninja checks for an output: the static inputs, and for a depfile edge the recorded deps. ";#raw("none");#" when a depfile edge has no entry.";

#raw(lang: "lean", block: true, "def effIns (st : St V) (e : MEdge) (o : Path) : Option (List Path) :=\n  if e.dyn then (st.deps o).map (e.ins ++ ·) else some e.ins")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.outDirty", "def:Mise.Model.St.outDirty", "Mise/Model/Basic.lean", 106, 115)

#"Whether output ";#raw("o");#" of ";#raw("e");#" is dirty: true when the file is missing, has no log entry, or (for a depfile edge) has no deps entry; when the logged command differs from the edge's; when the log time is older than the newest input Ninja checks; or, for an edge without ";#raw("restat");#", when the file is older than that input.";

#raw(lang: "lean", block: true, "def outDirty (st : St V) (e : MEdge) (o : Path) : Bool :=\n  match st.fs o, st.log o, st.effIns e o with\n  | some (_, t), some (c, lt), some D =>\n    (!e.restat && decide (t < st.newest D)) || c != e.cmd || decide (lt < st.newest D)\n  | _, _, _ => true")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.effIns"))[#raw("Model.St.effIns");];, #link(label("def:Mise.Model.St.newest"))[#raw("Model.St.newest");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.dirty", "def:Mise.Model.St.dirty", "Mise/Model/Basic.lean", 117, 119)

#"Whether Ninja runs the edge: some output is dirty (";#raw("outDirty");#").";

#template("Template", "whether {e} is dirty in {st}")

#raw(lang: "lean", block: true, "def dirty (st : St V) (e : MEdge) : Bool := e.outs.any (st.outDirty e)")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.outDirty"))[#raw("Model.St.outDirty");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.outVal", "def:Mise.Model.St.outVal", "Mise/Model/Basic.lean", 121, 124)

#"The contents a run writes to output ";#raw("o");#".";

#template("Template", "the contents that running {e} in {st} writes to {o}")

#raw(lang: "lean", block: true, "def outVal (sem : Sem V) (st : St V) (e : MEdge) (o : Path) : V :=\n  ((e.task sem).run st.content).getD (e.outs.idxOf o) default")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.MEdge.task"))[#raw("Model.MEdge.task");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.content"))[#raw("Model.St.content");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task.run"))[#raw("Task.run");];]

#def-heading("Model.St.kept", "def:Mise.Model.St.kept", "Mise/Model/Basic.lean", 126, 131)

#"A ";#raw("restat");#" command leaves output ";#raw("o");#" untouched (Stage 7).";

#template("Template", "whether running {e} in {st} leaves its output {o} untouched")

#raw(lang: "lean", block: true, "def kept (sem : Sem V) (st : St V) (e : MEdge) (o : Path) : Bool :=\n  e.restat && match st.fs o with\n    | some (old, _) => sem.keep old (st.outVal sem e o)\n    | none => false")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.outVal"))[#raw("Model.St.outVal");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.run", "def:Mise.Model.St.run", "Mise/Model/Basic.lean", 133, 142)

#"Run an edge's command: write every output it does not keep, its log entry and its deps entry at a fresh time. Writes are atomic.";

#template("Template", "the state after running {e} in {st}")

#raw(lang: "lean", block: true, "def run (sem : Sem V) (st : St V) (e : MEdge) : St V :=\n  let t := st.clock + 1\n  let D := (e.task sem).deps st.content\n  { fs := fun p => if e.outs.contains p && !st.kept sem e p then some (st.outVal sem e p, t) else st.fs p\n    log := fun p => if e.outs.contains p then some (e.cmd, t) else st.log p\n    deps := fun p => if e.outs.contains p then some D else st.deps p\n    clock := t }")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.MEdge.task"))[#raw("Model.MEdge.task");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.content"))[#raw("Model.St.content");];, #link(label("def:Mise.Model.St.kept"))[#raw("Model.St.kept");];, #link(label("def:Mise.Model.St.outVal"))[#raw("Model.St.outVal");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];, #link(label("def:Mise.Task.deps"))[#raw("Task.deps");];]

#def-heading("Model.St.step", "def:Mise.Model.St.step", "Mise/Model/Basic.lean", 144, 146)

#"Ninja's visit to an edge: run it if it is dirty, otherwise change nothing.";

#raw(lang: "lean", block: true, "def step (sem : Sem V) (st : St V) (e : MEdge) : St V :=\n  if st.dirty e then st.run sem e else st")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.dirty"))[#raw("Model.St.dirty");];, #link(label("def:Mise.Model.St.run"))[#raw("Model.St.run");];]

#def-heading("Model.St.edit", "def:Mise.Model.St.edit", "Mise/Model/Basic.lean", 148, 150)

#"A source edit: new contents at a fresh time.";

#raw(lang: "lean", block: true, "def edit (st : St V) (p : Path) (v : V) : St V :=\n  { st with fs := fun q => if q = p then some (v, st.clock + 1) else st.fs q, clock := st.clock + 1 }")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.edits", "def:Mise.Model.St.edits", "Mise/Model/Basic.lean", 152, 156)

#"Apply source edits in list order, each with ";#raw("edit");#".";

#template("Template", "{#1} after the edits {#2}")

#raw(lang: "lean", block: true, "def edits (st : St V) : List (Path × V) → St V\n  | [] => st\n  | (p, v) :: es => (st.edit p v).edits es")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.edit"))[#raw("Model.St.edit");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.Fresh", "def:Mise.Model.St.Fresh", "Mise/Model/Basic.lean", 158, 160)

#"Every recorded mtime and log time is at most the clock.";

#raw(lang: "lean", block: true, "def Fresh (st : St V) : Prop :=\n  (∀ p v t, st.fs p = some (v, t) → t ≤ st.clock) ∧ ∀ p c t, st.log p = some (c, t) → t ≤ st.clock")
#uses[#link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.buildTrace", "def:Mise.Model.buildTrace", "Mise/Model/Basic.lean", 174, 182)

#"Visit edges in order, running the dirty ones. Also returns the edges run.";

#template("Template", "the final state and the edges run when Ninja visits {#2} in order from {#3}")

#template("Template, first component", "the state after Ninja visits {#2} in order from {#3}")

#template("Template, second component", "the edges that run when Ninja visits {#2} in order from {#3}")

#raw(lang: "lean", block: true, "def buildTrace (sem : Sem V) : List MEdge → St V → St V × List MEdge\n  | [], st => (st, [])\n  | e :: es, st =>\n    let r := buildTrace sem es (st.step sem e)\n    (r.1, if st.dirty e then e :: r.2 else r.2)")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.dirty"))[#raw("Model.St.dirty");];, #link(label("def:Mise.Model.St.step"))[#raw("Model.St.step");];]

#def-heading("Model.ninjaBuild", "def:Mise.Model.ninjaBuild", "Mise/Model/Basic.lean", 184, 187)

#"One ";#raw("ninja");#" run on a manifest: visit the edges in manifest order, running the dirty ones, and return the final state.";

#raw(lang: "lean", block: true, "def ninjaBuild (sem : Sem V) (m : Manifest) (st : St V) : St V :=\n  (buildTrace sem m.medges st).1")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.buildTrace"))[#raw("Model.buildTrace");];, #link(label("def:Mise.Syntax.Manifest"))[#raw("Syntax.Manifest");];, #link(label("def:Mise.Syntax.Manifest.medges"))[#raw("Syntax.Manifest.medges");];]

#def-heading("Model.Disjoint", "def:Mise.Model.Disjoint", "Mise/Model/Basic.lean", 207, 209)

#"No path is in both lists.";

#template("Template", "no path is in both {a} and {b}")

#raw(lang: "lean", block: true, "def Disjoint (a b : List Path) : Prop := ∀ p ∈ a, p ∉ b")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.Sched", "def:Mise.Model.Sched", "Mise/Model/Basic.lean", 211, 216)

#"Edges in a schedulable order: no edge reads its own outputs or a later edge's outputs, order-only inputs included, and no two edges share an output.";

#raw(lang: "lean", block: true, "def Sched : List MEdge → Prop\n  | [] => True\n  | e :: es => Disjoint e.reads e.outs ∧ (∀ e' ∈ es, Disjoint e.reads e'.outs ∧ Disjoint e.outs e'.outs) ∧ Sched es")
#uses[#link(label("def:Mise.Model.Disjoint"))[#raw("Model.Disjoint");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.MEdge.reads"))[#raw("Model.MEdge.reads");];]

== #raw("Mise/Model/Sound.lean");

#def-heading("Model.Reach", "def:Mise.Model.Reach", "Mise/Model/Sound.lean", 729, 735)

#"The states reachable from empty logs by source edits and by running or skipping edges in any order. Interrupted builds, builds of some targets, and full builds are all sequences of steps.";

#raw(lang: "lean", block: true, "inductive Reach (es : List MEdge) : St V → Prop\n  | init {st : St V} : st.Fresh → (∀ p, st.log p = none) → (∀ p, st.deps p = none) → Reach es st\n  | edit {st : St V} (p : Path) (v : V) : Reach es st → (∀ e ∈ es, p ∉ e.outs) → Reach es (st.edit p v)\n  | step {st : St V} {e : MEdge} : Reach es st → e ∈ es → Reach es (st.step sem e)")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.Fresh"))[#raw("Model.St.Fresh");];, #link(label("def:Mise.Model.St.edit"))[#raw("Model.St.edit");];, #link(label("def:Mise.Model.St.step"))[#raw("Model.St.step");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

== #raw("Mise/Model/Cmp.lean");

#def-heading("Model.Files", "def:Mise.Model.Files", "Mise/Model/Cmp.lean", 116, 117)

#"The files: contents and mtime of each path, or ";#raw("none");#" when absent.";

#raw(lang: "lean", block: true, "abbrev Files (V : Type) := Path → Option (V × Nat)")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.aside", "def:Mise.Model.aside", "Mise/Model/Cmp.lean", 119, 121)

#"Where the wrapper moves an old output while its command runs.";

#template("Template", "the `.mise-old` file of {p}")

#raw(lang: "lean", block: true, "def aside (p : Path) : Path := p ++ \".mise-old\"")
#uses[#link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.mvF", "def:Mise.Model.mvF", "Mise/Model/Cmp.lean", 125, 126)

#raw("mv -f a b");#": ";#raw("b");#" gets ";#raw("a");#"'s file, mtime included, and ";#raw("a");#" is gone.";

#raw(lang: "lean", block: true, "def mvF (a b : Path) (fs : Files V) : Files V := fun p => if p = b then fs a else if p = a then none else fs p")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.rmF", "def:Mise.Model.rmF", "Mise/Model/Cmp.lean", 128, 129)

#raw("rm -f a");#".";

#raw(lang: "lean", block: true, "def rmF (a : Path) (fs : Files V) : Files V := fun p => if p = a then none else fs p")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.stash", "def:Mise.Model.stash", "Mise/Model/Cmp.lean", 131, 134)

#"The first loop, for output ";#raw("f");#": ";#raw("if [ -e f ]; then mv -f f f.mise-old; elif [ -e f.mise-old ]; then rm -f f.mise-old; fi");#".";

#raw(lang: "lean", block: true, "def stash (fs : Files V) (f : Path) : Files V :=\n  if (fs f).isSome then mvF f (aside f) fs else if (fs (aside f)).isSome then rmF (aside f) fs else fs")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Model.aside"))[#raw("Model.aside");];, #link(label("def:Mise.Model.mvF"))[#raw("Model.mvF");];, #link(label("def:Mise.Model.rmF"))[#raw("Model.rmF");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.command", "def:Mise.Model.command", "Mise/Model/Cmp.lean", 136, 143)

#"The command: it writes ";#raw("v");#" at time ";#raw("t");#" to each output ";#raw("f");#" with ";#raw("w f = some v");#", and changes no other file.";

#raw(lang: "lean", block: true, "def command (outs : List Path) (w : Path → Option V) (t : Nat) (fs : Files V) : Files V := fun p =>\n  if p ∈ outs then\n    match w p with\n    | some v => some (v, t)\n    | none => fs p\n  else fs p")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.settle", "def:Mise.Model.settle", "Mise/Model/Cmp.lean", 145, 157)

#"The last loop, for output ";#raw("f");#", where ";#raw("s");#" is whether the status is 0: ";#raw("if [ $s != 0 ]; then rm -f f; if [ -e f.mise-old ]; then mv -f f.mise-old f; fi; elif [ -e f.mise-old ]; then ...; fi");#". The elided part is ";#raw("rm -f f.mise-old");#", or with ";#raw("cmp");#" (a ";#raw("restat");#" rule) ";#raw("if cmp -s f f.mise-old; then mv -f f.mise-old f; else rm -f f.mise-old; fi");#".";

#raw(lang: "lean", block: true, "def settle (cmp s : Bool) (fs : Files V) (f : Path) : Files V :=\n  if !s then\n    let fs' := rmF f fs\n    if (fs' (aside f)).isSome then mvF (aside f) f fs' else fs'\n  else if (fs (aside f)).isSome then\n    if cmp && decide ((fs f).map (·.1) = (fs (aside f)).map (·.1)) then mvF (aside f) f fs\n    else rmF (aside f) fs\n  else fs")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Model.aside"))[#raw("Model.aside");];, #link(label("def:Mise.Model.mvF"))[#raw("Model.mvF");];, #link(label("def:Mise.Model.rmF"))[#raw("Model.rmF");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.script", "def:Mise.Model.script", "Mise/Model/Cmp.lean", 159, 168)

#"The script ";#raw("wrapCommand");#" emits, for a command with outputs ";#raw("outs");#" that leaves ";#raw("w");#" and exits 0 when ";#raw("ok");#", run at time ";#raw("t");#": the files afterwards, and whether the script exits 0. The status is 0 when the command exited 0 and every output exists.";

#raw(lang: "lean", block: true, "def script (cmp : Bool) (outs : List Path) (w : Path → Option V) (ok : Bool) (t : Nat) (fs : Files V) :\n    Files V × Bool :=\n  let fs₁ := outs.foldl stash fs\n  let fs₂ := command outs w t fs₁\n  let s := ok && outs.all fun f => (fs₂ f).isSome\n  (outs.foldl (settle cmp s) fs₂, s)")
#uses[#link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Model.command"))[#raw("Model.command");];, #link(label("def:Mise.Model.settle"))[#raw("Model.settle");];, #link(label("def:Mise.Model.stash"))[#raw("Model.stash");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Model.St.runWrapped", "def:Mise.Model.St.runWrapped", "Mise/Model/Cmp.lean", 376, 383)

#"Ninja runs edge ";#raw("e");#" through the wrapper at the next time step, where the command leaves ";#raw("w");#" at the outputs and exits 0 when ";#raw("ok");#". The files are what the script leaves. Ninja writes the log and deps entries only when the script exits 0.";

#template("Template", "the state after Ninja runs {e} from {st} through the wrapper, where the command leaves {w} at the outputs and exits 0 when {ok}")

#raw(lang: "lean", block: true, "def St.runWrapped (sem : Sem V) (st : St V) (e : MEdge) (w : Path → Option V) (ok : Bool) : St V :=\n  let r := script e.restat e.outs w ok (st.clock + 1) st.fs\n  if r.2 then { st.run sem e with fs := r.1 } else { st with fs := r.1 }")
#uses[#link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Model.Files"))[#raw("Model.Files");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.run"))[#raw("Model.St.run");];, #link(label("def:Mise.Model.script"))[#raw("Model.script");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

== #raw("Mise/Headline.lean");

#def-heading("Headline.edges", "def:Mise.Headline.edges", "Mise/Headline.lean", 47, 50)

#"The edges of the manifest ";#raw("mise");#" emits for ";#raw("g");#", as the Ninja model sees them.";

#template("Template", "the edges of the manifest for {g}")

#raw(lang: "lean", block: true, "abbrev edges (g : Graph) : List MEdge := (emit g).medges")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.emit"))[#raw("Frontend.emit");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Syntax.Manifest.medges"))[#raw("Syntax.Manifest.medges");];]

#def-heading("Headline.Reachable", "def:Mise.Headline.Reachable", "Mise/Headline.lean", 52, 56)

#raw("st");#" can arise from empty build and deps logs by any sequence of source edits and of edges run or skipped as Ninja would. Full builds, builds of some targets and interrupted builds are all such sequences.";

#template("Template", "{st} can arise for {g} from empty logs by source edits and Ninja edge visits")

#raw(lang: "lean", block: true, "abbrev Reachable (g : Graph) (st : St V) : Prop := Reach sem (edges g) st")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Headline.edges"))[#raw("Headline.edges");];, #link(label("def:Mise.Model.Reach"))[#raw("Model.Reach");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];]

#def-heading("Headline.build", "def:Mise.Headline.build", "Mise/Headline.lean", 58, 60)

#"The state after one ";#raw("ninja");#" run on the emitted manifest.";

#template("Template", "the state after one `ninja` run for {g} from {st}")

#raw(lang: "lean", block: true, "abbrev build (g : Graph) (st : St V) : St V := ninjaBuild sem (emit g) st")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Frontend.emit"))[#raw("Frontend.emit");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.ninjaBuild"))[#raw("Model.ninjaBuild");];]

#def-heading("Headline.ran", "def:Mise.Headline.ran", "Mise/Headline.lean", 62, 64)

#"The edges that one ";#raw("ninja");#" run executes, in order.";

#template("Template", "the edges one `ninja` run for {g} executes from {st}")

#raw(lang: "lean", block: true, "abbrev ran (g : Graph) (st : St V) : List MEdge := (buildTrace sem (edges g) st).2")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Frontend.Sem"))[#raw("Frontend.Sem");];, #link(label("def:Mise.Headline.edges"))[#raw("Headline.edges");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.buildTrace"))[#raw("Model.buildTrace");];]

#def-heading("Headline.IsSource", "def:Mise.Headline.IsSource", "Mise/Headline.lean", 66, 68)

#"No edge of the manifest writes ";#raw("p");#".";

#template("Template", "no edge of the manifest for {g} writes {p}")

#raw(lang: "lean", block: true, "abbrev IsSource (g : Graph) (p : Path) : Prop := ∀ e ∈ edges g, p ∉ e.outs")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Headline.edges"))[#raw("Headline.edges");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

#def-heading("Headline.ValidOrder", "def:Mise.Headline.ValidOrder", "Mise/Headline.lean", 70, 74)

#raw("es");#" is an order a parallel Ninja could run the edges in: the same edges as the manifest, where each edge reads no output of itself or of a later edge.";

#template("Template", "{es} is an order in which a parallel Ninja could run the edges for {g}")

#raw(lang: "lean", block: true, "abbrev ValidOrder (g : Graph) (es : List MEdge) : Prop := es.Perm (edges g) ∧ Sched es")
#uses[#link(label("def:Mise.Frontend.Graph"))[#raw("Frontend.Graph");];, #link(label("def:Mise.Headline.edges"))[#raw("Headline.edges");];, #link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.Sched"))[#raw("Model.Sched");];]

#def-heading("Headline.Checks", "def:Mise.Headline.Checks", "Mise/Headline.lean", 76, 80)

#raw("p");#" is an input Ninja checks for some output of ";#raw("e");#" in state ";#raw("st");#": a static input, or for a depfile edge a path its deps log entry records.";

#template("Template", "{p} is an input Ninja checks for some output of {e} in {st}")

#raw(lang: "lean", block: true, "abbrev Checks (st : St V) (e : MEdge) (p : Path) : Prop :=\n  ∃ o ∈ e.outs, ∃ D, st.effIns e o = some D ∧ p ∈ D")
#uses[#link(label("def:Mise.Model.MEdge"))[#raw("Model.MEdge");];, #link(label("def:Mise.Model.St"))[#raw("Model.St");];, #link(label("def:Mise.Model.St.effIns"))[#raw("Model.St.effIns");];, #link(label("def:Mise.Syntax.Path"))[#raw("Syntax.Path");];]

