#def-head("Syntax.Edge", "def:Mise.Syntax.Edge", "Mise/Syntax/Ast.lean", 37, 48, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L37-L48", ())[
