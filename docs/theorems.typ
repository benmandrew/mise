#def-head("Syntax.Ctx", "def:Mise.Syntax.Ctx", "Mise/Syntax/Ast.lean", 165, 170, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L165-L170")[
