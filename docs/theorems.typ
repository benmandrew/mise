#def-head("Frontend.GAlias", "def:Mise.Frontend.GAlias", "Mise/Frontend/Graph.lean", 82, 89, "https://github.com/benmandrew/mise/blob/main/Mise/Frontend/Graph.lean#L82-L89")[
