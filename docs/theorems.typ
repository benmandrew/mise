#def-head("Syntax.Manifest", "def:Mise.Syntax.Manifest", "Mise/Syntax/Ast.lean", 59, 64, "https://github.com/benmandrew/mise/blob/main/Mise/Syntax/Ast.lean#L59-L64")[
